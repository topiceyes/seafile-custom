diff --git a/tests/seahub/views/test_client_sso_origin.py b/tests/seahub/views/test_client_sso_origin.py
new file mode 100644
index 00000000..82f85bd7
--- /dev/null
+++ b/tests/seahub/views/test_client_sso_origin.py
@@ -0,0 +1,136 @@
+"""Client SSO must open the browser on the entry that issued the request."""
+from datetime import timedelta
+from types import ModuleType
+from unittest.mock import patch
+from urllib.parse import parse_qs, urlencode, urlsplit
+
+from django.core.exceptions import DisallowedHost
+from django.db import DatabaseError, transaction
+from django.test import RequestFactory, SimpleTestCase, override_settings
+from django.urls import include, path
+from django.utils import timezone
+from rest_framework.test import APIRequestFactory
+
+from seahub.api2.endpoints.sso.client_sso_link import ClientSSOLink
+from seahub.base.models import ClientSSOToken, STATUS_ERROR
+from seahub.views.sso import client_sso, client_sso_complete
+
+
+routes = [
+    path('client-sso/<str:token>/', client_sso, name='client_sso'),
+    path('client-sso/<str:token>/complete/', client_sso_complete, name='client_sso_complete'),
+]
+urls = ModuleType('client_sso_origin_test_urls')
+urls.urlpatterns = routes
+prefixed_urls = ModuleType('client_sso_origin_prefixed_test_urls')
+prefixed_urls.urlpatterns = [path('seafile/', include(routes))]
+
+
+@override_settings(
+    ROOT_URLCONF=urls,
+    ALLOWED_HOSTS=['m-disc.example.test', 'i-disc.example.test', '192.0.2.10'],
+    USE_X_FORWARDED_HOST=False,
+    SECURE_PROXY_SSL_HEADER=('HTTP_X_FORWARDED_PROTO', 'https'),
+)
+class ClientSSOOriginTest(SimpleTestCase):
+    databases = {'default'}
+
+    def setUp(self):
+        self.factory = APIRequestFactory()
+        self.canonical = patch('seahub.utils.get_service_url',
+                               return_value='https://canonical.example.test')
+        self.canonical_mock = self.canonical.start()
+        self.addCleanup(self.canonical.stop)
+        self.addCleanup(ClientSSOToken.objects.all().delete)
+
+    def create(self, host='m-disc.example.test', secure=True, params=None, **headers):
+        query = '?' + urlencode(params) if params else ''
+        request = self.factory.post('/api2/client-sso-link/' + query,
+                                    HTTP_HOST=host, secure=secure, **headers)
+        return ClientSSOLink.as_view(throttle_classes=[], authentication_classes=[])(request)
+
+    def test_links_follow_each_origin_and_preserve_device_parameters(self):
+        params = {
+            'shib_platform': 'mac', 'shib_device_id': 'a' * 40,
+            'shib_device_name': '测试 Mac & desk', 'shib_client_version': '9.0.21',
+            'shib_platform_version': '15.0',
+        }
+        for host, secure in [('m-disc.example.test', True),
+                             ('i-disc.example.test:7443', True), ('192.0.2.10:9800', False)]:
+            with self.subTest(host=host):
+                response = self.create(host, secure, params)
+                self.assertEqual(response.status_code, 200)
+                link = urlsplit(response.data['link'])
+                self.assertEqual((link.scheme, link.netloc), ('https' if secure else 'http', host))
+                self.assertEqual(parse_qs(link.query), {key: [value] for key, value in params.items()})
+                token = link.path.strip('/').split('/')[-1]
+                self.assertEqual(len(token), 60)
+                self.assertTrue(ClientSSOToken.objects.get(token=token).is_waiting())
+        self.canonical_mock.assert_not_called()
+
+    def test_no_device_parameters_keeps_same_origin_without_empty_query(self):
+        response = self.create()
+        self.assertTrue(response.data['link'].startswith('https://m-disc.example.test/client-sso/'))
+        self.assertNotIn('?', response.data['link'])
+
+    def test_proxy_scheme_and_untrusted_forwarded_host(self):
+        response = self.create(secure=False, HTTP_X_FORWARDED_PROTO='https',
+                               HTTP_X_FORWARDED_HOST='i-disc.example.test:7443')
+        self.assertEqual(urlsplit(response.data['link']).netloc, 'm-disc.example.test')
+        self.assertEqual(urlsplit(response.data['link']).scheme, 'https')
+
+    def test_invalid_host_does_not_create_a_token(self):
+        for host in ['evil.example.test', 'm-disc.example.test/evil']:
+            with self.subTest(host=host), self.assertRaises(DisallowedHost):
+                self.create(host)
+        self.assertEqual(ClientSSOToken.objects.count(), 0)
+
+    @override_settings(ROOT_URLCONF=prefixed_urls)
+    def test_site_prefix_is_preserved_by_reverse(self):
+        response = self.create()
+        self.assertTrue(response.data['link'].startswith('https://m-disc.example.test/seafile/client-sso/'))
+
+    def test_browser_redirect_stays_relative_and_retains_device_parameters(self):
+        params = {'shib_platform': 'mac', 'shib_device_name': 'Mac & desk'}
+        link = urlsplit(self.create(params=params).data['link'])
+        token = link.path.strip('/').split('/')[-1]
+        request = RequestFactory().get(link.path + '?' + link.query,
+                                       HTTP_HOST=link.netloc, secure=True)
+        response = client_sso(request, token)
+        self.assertEqual(response.status_code, 302)
+        redirect = urlsplit(response['Location'])
+        self.assertEqual(redirect.netloc, '')
+        self.assertEqual(redirect.path, '/accounts/login/')
+        next_page = urlsplit(parse_qs(redirect.query)['next'][0])
+        self.assertEqual(next_page.netloc, '')
+        self.assertEqual(next_page.path, '/client-sso/%s/complete/' % token)
+        self.assertEqual(parse_qs(next_page.query), {key: [value] for key, value in params.items()})
+        self.assertIsNotNone(ClientSSOToken.objects.get(token=token).accessed_at)
+
+    def test_waiting_status_does_not_issue_an_api_token(self):
+        self.create()
+        token = ClientSSOToken.objects.get()
+        request = self.factory.get('/api2/client-sso-link/%s/' % token.token)
+        response = ClientSSOLink.as_view(throttle_classes=[], authentication_classes=[])(request, token=token.token)
+        self.assertEqual(response.data, {'status': 'waiting'})
+
+    def test_expired_success_status_does_not_disclose_credentials(self):
+        self.create()
+        token = ClientSSOToken.objects.get()
+        token.accessed_at = timezone.now() - timedelta(days=1)
+        token.completed(username='member@example.test', api_key='test-key')
+        request = self.factory.get('/api2/client-sso-link/%s/' % token.token)
+        response = ClientSSOLink.as_view(throttle_classes=[], authentication_classes=[])(request, token=token.token)
+        self.assertEqual(response.data, {'status': STATUS_ERROR})
+
+    def test_missing_token_is_not_found(self):
+        request = self.factory.get('/api2/client-sso-link/missing/')
+        response = ClientSSOLink.as_view(throttle_classes=[], authentication_classes=[])(request, token='missing')
+        self.assertEqual(response.status_code, 404)
+
+    def test_save_failure_rolls_back_and_restores_autocommit(self):
+        with patch.object(ClientSSOToken, 'save', side_effect=DatabaseError('test failure')):
+            response = self.create()
+        self.assertEqual(response.status_code, 500)
+        self.assertEqual(ClientSSOToken.objects.count(), 0)
+        self.assertTrue(transaction.get_autocommit())
