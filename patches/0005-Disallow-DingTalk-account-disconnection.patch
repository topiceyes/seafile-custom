From bdf79b74dd80e028af0d3aa4e40b89535f98b654 Mon Sep 17 00:00:00 2001
From: iceyes <iceyes@iceyesdeMac-mini.local>
Date: Wed, 16 Sep 2026 23:53:31 +0800
Subject: [PATCH 5/7] Disallow DingTalk account disconnection

Enterprise policy: DingTalk identity is the only login method for
regular users; disconnecting would lock the account out. Block the
disconnect API (friendly error) and replace the Disconnect button
with a status hint on the user settings page.
---
 .../src/components/user-settings/social-login-dingtalk.js | 2 +-
 frontend/webpack-stats.pro.json                           | 8 ++++----
 seahub/dingtalk/views.py                                  | 3 +++
 3 files changed, 8 insertions(+), 5 deletions(-)

diff --git a/frontend/src/components/user-settings/social-login-dingtalk.js b/frontend/src/components/user-settings/social-login-dingtalk.js
index 55eb8d1..97e121e 100644
--- a/frontend/src/components/user-settings/social-login-dingtalk.js
+++ b/frontend/src/components/user-settings/social-login-dingtalk.js
@@ -38,7 +38,7 @@ class SocialLoginDintalk extends React.Component {
           <h3 className="setting-item-heading">{gettext('Social Login')}</h3>
           <p className="mb-2">{langCode == 'zh-cn' ? '钉钉' : 'Dingtalk'}</p>
           {socialConnectedDingtalk ?
-            <button className="btn btn-outline-primary" onClick={this.confirmDisconnect}>{gettext('Disconnect')}</button> :
+            <p className="m-0">{langCode == 'zh-cn' ? '已连接（如需更换请联系管理员）' : 'Connected (contact administrator to change)'}</p> :
             <a href={`${siteRoot}dingtalk/connect/?next=${encodeURIComponent(socialNextPage)}`} className="btn btn-outline-primary">{gettext('Connect')}</a>
           }
         </div>
