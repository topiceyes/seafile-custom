diff --git a/seahub/dingtalk/handoff.py b/seahub/dingtalk/handoff.py
new file mode 100644
index 00000000..5797f097
--- /dev/null
+++ b/seahub/dingtalk/handoff.py
@@ -0,0 +1,88 @@
+"""One-time client SSO handoffs; never transfer browser sessions or API keys."""
+import hashlib
+import secrets
+from datetime import timedelta
+
+from django.db import transaction
+from django.urls import reverse
+from django.utils import timezone
+from urllib.parse import urlsplit
+
+from seahub.base.models import ClientSSOToken
+from seahub.settings import CLIENT_SSO_TOKEN_EXPIRATION
+from .models import ClientSSOHandoff
+
+SESSION_TARGETS = 'client_sso_dingtalk_targets'
+
+
+class InvalidHandoff(Exception):
+    pass
+
+
+def _digest(value):
+    return hashlib.sha256(value.encode()).hexdigest()
+
+
+def remember_target(session, token, destination):
+    # A separate entry per tab avoids confirming a different client's request.
+    targets = dict(session.get(SESSION_TARGETS, {}))
+    targets[_digest(destination)] = {'token': token, 'destination': destination}
+    session[SESSION_TARGETS] = dict(list(targets.items())[-5:])
+
+
+def session_target(session, destination):
+    target = session.get(SESSION_TARGETS, {}).get(_digest(destination), {})
+    return target if target.get('destination') == destination else {}
+
+
+def _pending(token):
+    if not token or not token.accessed_at or not token.is_waiting():
+        return False
+    age = (timezone.now() - token.accessed_at).total_seconds()
+    return 0 <= age < CLIENT_SSO_TOKEN_EXPIRATION
+
+
+def _origin(request):
+    return request.scheme + '://' + request.get_host()
+
+
+def _destination_valid(destination, token):
+    parts = urlsplit(destination)
+    return (not parts.scheme and not parts.netloc and not parts.fragment and
+            parts.path == reverse('client_sso_complete', args=[token]))
+
+
+def create_handoff(request, destination):
+    target = session_target(request.session, destination)
+    ClientSSOHandoff.objects.filter(created_at__lt=timezone.now() - timedelta(seconds=CLIENT_SSO_TOKEN_EXPIRATION)).delete()
+    with transaction.atomic():
+        token = ClientSSOToken.objects.select_for_update().filter(token=target.get('token', '')).first()
+        if not _pending(token) or not _destination_valid(destination, token.token):
+            raise InvalidHandoff()
+        now = timezone.now()
+        # A deliberate retry invalidates older, unclaimed links for this client.
+        ClientSSOHandoff.objects.filter(client_token=token.token, used_at__isnull=True).update(used_at=now)
+        secret = secrets.token_urlsafe(32)
+        ClientSSOHandoff.objects.create(secret_hash=_digest(secret), client_token=token.token,
+                                        destination=destination, origin=_origin(request))
+        return secret
+
+
+@transaction.atomic
+def consume_handoff(request, secret):
+    if (len(secret) != 43 or any(c not in 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_' for c in secret)):
+        raise InvalidHandoff()
+    # Lock the client before the bridge in both creation and consumption.
+    candidate = ClientSSOHandoff.objects.filter(secret_hash=_digest(secret)).first()
+    if not candidate:
+        raise InvalidHandoff()
+    token = ClientSSOToken.objects.select_for_update().filter(token=candidate.client_token).first()
+    handoff = ClientSSOHandoff.objects.select_for_update().filter(pk=candidate.pk).first()
+    if (not handoff or handoff.used_at or not _pending(token) or
+            handoff.origin != _origin(request) or
+            not _destination_valid(handoff.destination, token.token) or
+            (timezone.now() - handoff.created_at).total_seconds() >= CLIENT_SSO_TOKEN_EXPIRATION):
+        raise InvalidHandoff()
+    handoff.used_at = timezone.now()
+    handoff.save(update_fields=['used_at'])
+    return handoff.destination
