+        response = dingtalk_login_new(req)
+        self.assertEqual(req.session['dingtalk_login_redirect'], '/normal-page/')
+        self.assertEqual(response.status_code, 302)
+
+    def test_inactive_user_or_expired_confirmation_cannot_issue_token(self):
+        req = self.request('post', self.destination)
