--- /dev/null
+++ b/tests/seahub/views/test_dingtalk_handoff.py
@@ -0,0 +1,245 @@
+"""Exercise real templates, CSRF checks and the bridge using isolated tables."""
+from datetime import timedelta
+from html.parser import HTMLParser
+from types import SimpleNamespace
+from unittest.mock import patch
+from urllib.parse import parse_qs, urlencode, urlsplit
+
+import requests
+from django.http import HttpResponse
+from django.template import engines
+from django.test import RequestFactory, SimpleTestCase, override_settings
+from django.utils import timezone
+from django.middleware.csrf import get_token
+
+from seahub.base.models import ClientSSOToken
+from seahub.dingtalk.models import ClientSSOHandoff
+from seahub.dingtalk.handoff import remember_target
+from seahub.dingtalk.views import dingtalk_callback_new, dingtalk_login_new
+from seahub.views.sso import (client_sso, client_sso_complete,
+                              client_sso_dingtalk_prepare, client_sso_dingtalk_landing)
+
+
+class Links(HTMLParser):
+    def __init__(self, html):
+        super().__init__()
+        self.links = []
+        self.feed(html)
+
+    def handle_starttag(self, tag, attrs):
+        if tag == 'a':
+            self.links.append(dict(attrs).get('href', ''))
+
+
+@override_settings(ALLOWED_HOSTS=['testserver', 'other.test'], ROOT_URLCONF='seahub.urls')
+class DingTalkHandoffTest(SimpleTestCase):
+    databases = {'default'}
+
+    def setUp(self):
+        self.factory = RequestFactory()
+        for name in ['seahub.views.sso.is_dingtalk_enabled',
+                     'seahub.views.sso.get_dingtalk_app_key',
+                     'seahub.views.sso.get_dingtalk_app_secret',
+                     'seahub.dingtalk.views.get_dingtalk_app_key']:
+            mock = patch(name, return_value='test-value')
+            mock.start()
+            self.addCleanup(mock.stop)
+        self.addCleanup(ClientSSOHandoff.objects.all().delete)
+        self.addCleanup(ClientSSOToken.objects.all().delete)
+        self.token = ClientSSOToken.objects.create(accessed_at=timezone.now())
+        self.destination = '/client-sso/%s/complete/?%s' % (self.token.token, urlencode({
+            'shib_platform': 'ios', 'shib_device_id': 'device-test-id',
+            'shib_device_name': 'My iPhone & phone', 'shib_client_version': 'test',
+            'shib_platform_version': 'test'}))
+        self.session = {}
+        remember_target(self.session, self.token.token, self.destination)
+
+    def request(self, method, path, data=None, session=None, csrf=True, host='testserver'):
+        req = getattr(self.factory, method)(path, data or {}, secure=True, HTTP_HOST=host)
+        req.session = session if session is not None else {}
+        req.user = SimpleNamespace(username='member@example.test', is_authenticated=True, is_active=True)
+        if method == 'post' and csrf:
+            # Use the real CSRF validation, including Origin validation.
+            secret = get_token(req)
+            req.COOKIES['sfcsrftoken'] = req.META['CSRF_COOKIE']
+            req.COOKIES['csrftoken'] = req.META['CSRF_COOKIE']
+            req.META['HTTP_X_CSRFTOKEN'] = secret
+            req.META['HTTP_ORIGIN'] = 'https://' + host
+        return req
+
+    def prepare(self, destination=None):
+        req = self.request('post', '/client-sso-dingtalk/prepare/',
+                           {'next': destination or self.destination}, session=self.session)
+        return client_sso_dingtalk_prepare(req)
+
+    def secret(self, response):
+        link = next(link for link in Links(response.content.decode()).links if link.startswith('dingtalk:'))
+        landing = parse_qs(urlsplit(link).query)['url'][0]
+        self.assertNotIn(self.token.token, link)
+        self.assertNotIn('shib_', link)
+        self.assertEqual(urlsplit(landing).netloc, 'testserver')
+        return urlsplit(landing).fragment
+
+    def consume(self, secret, **kwargs):
+        req = self.request('post', '/client-sso-dingtalk/landing/', {'handoff': secret}, **kwargs)
+        return req, client_sso_dingtalk_landing(req)
+
+    def test_cross_session_oauth_then_explicit_client_confirmation(self):
+        response = self.prepare()
+        self.assertEqual(response.status_code, 200)
+        secret = self.secret(response)
+        self.assertNotEqual(secret, ClientSSOHandoff.objects.get().secret_hash)
+        req, response = self.consume(secret)
+        self.assertEqual(response.status_code, 302)
+        self.assertEqual(urlsplit(response['Location']).netloc, 'login.dingtalk.com')
+        self.assertEqual(req.session['dingtalk_login_redirect'], self.destination)
+        query = parse_qs(urlsplit(response['Location']).query)
+        self.assertEqual(query['state'], [req.session['dingtalk_login_state']])
+        self.assertEqual(query['redirect_uri'], ['https://testserver/dingtalk/callback/'])
+        self.token.refresh_from_db()
+        self.assertTrue(self.token.is_waiting())
+        self.assertIsNone(self.token.api_key)
+        self.assertEqual(self.consume(secret)[1].status_code, 400)
+        with patch('seahub.views.sso.email2nickname', return_value='Test Member'), \
+                patch('seahub.views.sso.get_token_v2', return_value=SimpleNamespace(key='api-test-key')) as issue:
+            confirm = self.request('get', self.destination, session=req.session)
+            response = client_sso_complete(confirm, self.token.token)
+            self.assertEqual(response.status_code, 200)
+            self.assertIn('Test Member', response.content.decode())
+            self.assertIn('My iPhone &amp; phone', response.content.decode())
+            issue.assert_not_called()
+            post = self.request('post', self.destination, session=req.session)
+            self.assertEqual(client_sso_complete(post, self.token.token).status_code, 200)
+            issue.assert_called_once_with(post, 'member@example.test', 'ios', 'device-test-id',
+                                          'My iPhone & phone', 'test', 'test')
+            self.assertEqual(client_sso_complete(post, self.token.token).status_code, 200)
+            self.assertEqual(issue.call_count, 1)
+        self.token.refresh_from_db()
+        self.assertEqual(self.token.api_key, 'api-test-key')
+
+    def test_retry_invalidates_unclaimed_link(self):
+        first = self.secret(self.prepare())
+        second = self.secret(self.prepare())
+        self.assertNotEqual(first, second)
+        self.assertEqual(self.consume(first)[1].status_code, 400)
+        self.assertEqual(self.consume(second)[1].status_code, 302)
+
+    def test_origin_mismatch_does_not_consume_link(self):
+        secret = self.secret(self.prepare())
+        self.assertEqual(self.consume(secret, host='other.test')[1].status_code, 400)
+        self.assertEqual(self.consume(secret)[1].status_code, 302)
+
+    def test_multiple_tabs_keep_their_own_destination(self):
+        other = ClientSSOToken.objects.create(accessed_at=timezone.now())
+        other_destination = '/client-sso/%s/complete/' % other.token
+        remember_target(self.session, other.token, other_destination)
+        first = self.secret(self.prepare())
+        self.assertEqual(self.consume(first)[0].session['dingtalk_login_redirect'], self.destination)
+        second = self.secret(self.prepare(other_destination))
+        self.assertEqual(self.consume(second)[0].session['dingtalk_login_redirect'], other_destination)
+
+    def test_missing_session_or_tampered_destination_cannot_prepare(self):
+        response = self.prepare(self.destination + '&shib_device_name=OTHER')
+        self.assertEqual(response.status_code, 400)
+        self.session.clear()
+        self.assertEqual(self.prepare().status_code, 400)
+        self.assertEqual(ClientSSOHandoff.objects.count(), 0)
+
+    def test_expired_completed_and_deleted_clients_are_rejected(self):
+        for mode in ['expired', 'success', 'deleted']:
+            with self.subTest(mode=mode):
+                secret = self.secret(self.prepare())
+                pk = self.token.pk
+                if mode == 'expired':
+                    ClientSSOToken.objects.filter(pk=pk).update(accessed_at=timezone.now() - timedelta(hours=1))
+                elif mode == 'success':
+                    ClientSSOToken.objects.filter(pk=pk).update(status='success')
+                else:
+                    self.token.delete()
+                self.assertEqual(self.consume(secret)[1].status_code, 400)
+                self.token.pk = pk
+                self.token.accessed_at = timezone.now()
+                self.token.status = 'waiting'
+                self.token.save()
+
+    def test_expired_handoff_and_malformed_secrets(self):
+        secret = self.secret(self.prepare())
+        ClientSSOHandoff.objects.update(created_at=timezone.now() - timedelta(hours=1))
+        for value in [secret, '', 'x' * 200, 'a/b' * 14 + 'a']:
+            self.assertEqual(self.consume(value)[1].status_code, 400)
+
+    def test_csrf_is_required_and_missing_fragment_has_recovery_message(self):
+        req = self.request('post', '/client-sso-dingtalk/prepare/', {'next': self.destination}, session=self.session, csrf=False)
+        self.assertEqual(client_sso_dingtalk_prepare(req).status_code, 403)
+        secret = self.secret(self.prepare())
+        self.assertEqual(self.consume(secret, csrf=False)[1].status_code, 403)
+        get = self.request('get', '/client-sso-dingtalk/landing/')
+        response = client_sso_dingtalk_landing(get)
+        html = response.content.decode()
+        self.assertIn('handoff-invalid', html)
+        self.assertIn('history.replaceState', html)
+        self.assertNotIn('src=', html)  # No third-party resources see the fragment.
+        self.assertIn('no-store', response['Cache-Control'])
+        self.assertEqual(response['Referrer-Policy'], 'no-referrer')
+
+    def test_disabled_login_blocks_both_endpoints(self):
+        secret = self.secret(self.prepare())
+        with patch('seahub.views.sso.is_dingtalk_enabled', return_value=False):
+            self.assertEqual(self.prepare().status_code, 400)
+            self.assertEqual(self.consume(secret)[1].status_code, 400)
+        self.assertEqual(self.consume(secret)[1].status_code, 302)
+
+    def test_oauth_cancellation_invalid_state_and_timeout_do_not_call_identity_backend(self):
+        with patch('seahub.dingtalk.views.auth.authenticate') as authenticate, \
+                patch('seahub.dingtalk.views.requests.post') as post:
+            for query, session in [({'state': 'bad'}, {'dingtalk_login_state': 'expected'}),
+                                   ({'state': 'ok', 'error': 'access_denied'}, {'dingtalk_login_state': 'ok'}),
+                                   ({'state': 'ok'}, {'dingtalk_login_state': 'ok'})]:
+                req = self.request('get', '/dingtalk/callback/?' + urlencode(query), session=session)
+                self.assertEqual(dingtalk_callback_new(req).status_code, 200)
+            post.assert_not_called()
+            post.side_effect = requests.Timeout()
+            req = self.request('get', '/dingtalk/callback/?state=ok&authCode=test-code',
+                               session={'dingtalk_login_state': 'ok'})
+            dingtalk_callback_new(req)
+            authenticate.assert_not_called()
+            self.assertNotIn('dingtalk_login_state', req.session)
+
+    def test_templates_keep_desktop_and_non_client_login_compatible(self):
+        template = engines['django'].get_template('registration/login.html')
+        for available in [True, False]:
+            req = self.request('get', '/accounts/login/')
+            html = template.render({'request': req, 'enable_dingtalk': True,
+                                    'client_sso_dingtalk_available': available,
+                                    'next': self.destination})
+            self.assertIn('id="dingtalk-web-login"', html)
