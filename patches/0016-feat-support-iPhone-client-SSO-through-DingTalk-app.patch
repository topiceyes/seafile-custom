diff --git a/seahub/templates/client_dingtalk_landing.html b/seahub/templates/client_dingtalk_landing.html
new file mode 100644
index 00000000..ad0829ba
--- /dev/null
+++ b/seahub/templates/client_dingtalk_landing.html
@@ -0,0 +1,34 @@
+{% load i18n %}
+<!doctype html>
+<html lang="{{ LANGUAGE_CODE|default:'zh-cn' }}">
+<head>
+  <meta charset="utf-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1" />
+  <meta name="referrer" content="no-referrer" />
+  <title>{% trans "DingTalk Login" %}</title>
+  <style>body{font:17px -apple-system,sans-serif;line-height:1.6;max-width:32rem;margin:3rem auto;padding:0 1rem}button{font:inherit;padding:.6rem 1rem}</style>
+</head>
+<body>
+  <p id="handoff-message">{% trans "Continue to DingTalk authorization." %}</p>
+  <form id="handoff" method="post" hidden>{% csrf_token %}
+    <input type="hidden" name="handoff" id="handoff-secret" />
+    <button type="submit">{% trans "Continue" %}</button>
+  </form>
+  <p id="handoff-invalid" hidden>{% trans "This login link is invalid or has expired. Please start Single Sign-On again in the Seafile app." %}</p>
+  <noscript>{% trans "Please enable JavaScript and start Single Sign-On again in the Seafile app." %}</noscript>
+  <script>
+    (function () {
+      var secret = window.location.hash.slice(1);
+      history.replaceState(null, '', window.location.pathname);
+      if (/^[A-Za-z0-9_-]{43}$/.test(secret)) {
+        document.getElementById('handoff-secret').value = secret;
+        document.getElementById('handoff').hidden = false;
+        document.getElementById('handoff').submit();
+      } else {
+        document.getElementById('handoff-message').hidden = true;
+        document.getElementById('handoff-invalid').hidden = false;
+      }
+    }());
+  </script>
+</body>
+</html>
