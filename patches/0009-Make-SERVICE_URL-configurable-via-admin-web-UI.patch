 def get_service_url():
-    """Get service url from seaserv.
+    """站点公开地址（SERVICE_URL）。
+
+    [dev] 已 constance 化：管理员在「系统管理 → 设置」页填，免重启生效。
+    默认值来自 seahub_settings.py / 环境变量，后台保存后覆盖；后台清空则回落默认。
+
+    读这个值必须走本函数，不要在模块级 `from seahub.settings import SERVICE_URL`
+    ——那样会在启动期固化，后台改了不生效（context_processors 与 OCM 都踩过）。
+
+    所有派生地址都跟着它走：分享链接、下载链接、邮件里的链接，以及钉钉回调
+    地址（get_site_scheme_and_netloc() 从这里取 scheme+netloc）。
     """
-    return seahub.settings.SERVICE_URL
+    try:
+        from constance import config
+        url = config.SERVICE_URL or ''
+    except Exception:
+        # constance 不可用（数据库未就绪 / 表未迁移 / 独立脚本）时静默回落，
+        # 不能让它把启动期或迁移期打断
+        url = ''
+
+    if not url:
+        url = seahub.settings.SERVICE_URL
+
+    return url.rstrip('/')
 
