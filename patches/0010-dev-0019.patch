+# [dev] 0019 钉钉展示名取真实姓名（topapi v2 user/get 的 result.name）。
+# OAuth userinfo 的 nick 是钉钉昵称（常为英文名/别名），不是通讯录真实姓名；
+# Profile.nickname 同时驱动展示（email2nickname）和用户搜索（nickname__icontains）。
+def _dingtalk_detailed_name(detailed_user_info):
+    if not isinstance(detailed_user_info, dict):
+        return ''
+    if detailed_user_info.get('errcode', 0) != 0:
+        return ''
+    result = detailed_user_info.get('result') or {}
+    if not isinstance(result, dict):
+        return ''
+    return str(result.get('name') or '').strip()[:64]
+
+
+def _pick_display_name(detailed_name, oauth_nick, current_nickname):
+    """Pick the display name to write to Profile.nickname.
+
+    - 真实姓名优先；
+    - user/get 失败（detailed_name 为空）时，已有昵称保持不动——否则一次瞬时失败
+      会把已修正的真实姓名打回 nick，正是 0019 要修的 bug；
+    - 只有当前昵称为空时才用 OAuth 的 nick 兜底（首次登录场景）。
+    """
+    if detailed_name:
+        return detailed_name
+    if (current_nickname or '').strip():
+        return ''
+    return str(oauth_nick or '').strip()[:64]
+
+
