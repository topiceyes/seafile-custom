+    # ---------------- 真实姓名回填（0019） ----------------
+
+    def _sync_nicknames(self, member_names):
+        """把钉钉真实姓名回填到 Profile.nickname。
+
+        展示（email2nickname）和用户搜索（nickname__icontains）都读这个字段。
+        只更新有绑定账号且 name 非空的用户；空 name 跳过，绝不清空昵称。
+        """
+        if not member_names:
+            self.println('Nickname sync: no DingTalk member names, skip')
+            return
+        if not any(member_names.values()):
+            self.stderr.write('WARN: DingTalk user/list returned no name field, '
+                              'skip nickname sync.')
+            return
+
+        # 按 username 去重（同一用户可能在多个部门）。批量查询后仍做精确 uid
+        # 匹配：MySQL 默认排序规则大小写不敏感，uid__in 可能多匹配。
+        desired = {}
+        bindings = SocialAuthUser.objects.filter(
+            provider=DINGTALK_PROVIDER, uid__in=list(member_names))
+        for binding in bindings:
+            if binding.uid not in member_names:
+                continue
+            real_name = (member_names.get(binding.uid) or '').strip()
+            if not real_name:
+                continue
+            old = desired.get(binding.username)
+            if old is None:
+                desired[binding.username] = real_name
+            elif old != real_name:
+                logger.warning('Conflicting DingTalk names for %s: %r vs %r, keep %r',
+                               binding.username, old, real_name, old)
+
+        skipped_empty = sum(1 for n in member_names.values() if not n)
+        if not desired:
+            self.println('Nickname sync: renamed=0 unchanged=0 skipped_empty=%d'
+                         % skipped_empty)
+            return
+
+        profiles = {p.user: p for p in Profile.objects.filter(user__in=desired.keys())}
+        renamed = unchanged = 0
+        for username, real_name in sorted(desired.items()):
+            profile = profiles.get(username)
+            current = (profile.nickname if profile else '') or ''
+            if current.strip() == real_name:
+                unchanged += 1
+                continue
+            self.println('RENAME nickname %s: %r -> %r'
+                         % (username, current, real_name))
+            if not self.dry_run:
+                if profile is None:
+                    profile = Profile(user=username)
+                profile.nickname = real_name
+                try:
+                    # Profile.save() 触发 post_save 刷新 email2nickname 缓存；
+                    # QuerySet.update() 不会，会留下 24h 旧昵称。
+                    profile.save()
+                except Exception as e:
+                    logger.error('Update nickname for %s failed: %s', username, e)
+                    continue
+            renamed += 1
+
+        self.println('Nickname sync: renamed=%d unchanged=%d skipped_empty=%d'
+                     % (renamed, unchanged, skipped_empty))
 
     # ---------------- 漂移告警 ----------------
 
