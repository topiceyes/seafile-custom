 .../src/components/admin/departments/department-menu.js    | 7 ++++---
 frontend/src/pages/sys-admin/departments/index.js          | 4 +++-
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/frontend/src/components/admin/departments/department-menu.js b/frontend/src/components/admin/departments/department-menu.js
index b770d054..f06e4f03 100644
--- a/frontend/src/components/admin/departments/department-menu.js
+++ b/frontend/src/components/admin/departments/department-menu.js
@@ -3,15 +3,16 @@ import { gettext, isPro } from '@/utils/constants';
 export function getDepartmentMenuItems({ node, toggleDelete, toggleRename, toggleAddMembers, toggleAddDepartment, toggleAddLibrary, toggleSetQuotaDialog, toggleMoveDepartment }) {
   const items = [
     { key: `${node.id}-add-department`, label: gettext('Add sub-department'), onClick: () => toggleAddDepartment(node) },
-    { key: `${node.id}-add-repo`, label: gettext('Add Library'), onClick: () => toggleAddLibrary(node) },
     { key: `${node.id}-add-members`, label: gettext('Add members'), onClick: () => toggleAddMembers(node) },
     { key: `${node.id}-rename`, label: gettext('Rename'), onClick: () => toggleRename(node) },
     { key: `${node.id}-delete`, label: gettext('Delete'), onClick: () => toggleDelete(node) },
     { key: `${node.id}-move`, label: gettext('Move department'), onClick: () => toggleMoveDepartment(node) },
   ];
-  // [dev] 0014: 配额是 Pro C 核心 API，CE 无 set_group_quota——隐藏入口
-  // （后端 PUT quota 在 CE 下也会明确拒绝，双保险）
+  // [dev] 0014: 部门资料库（组属主库）依赖 Pro C 核心 RPC（CE 实测无
+  // add_group_owned_repo）——CE 隐藏建库入口；共享给部门的库仍在列表页可见。
+  // 「Add Library」与「Set quota」同属 Pro-only，一并按 isPro 过滤
   if (isPro) {
+    items.splice(1, 0, { key: `${node.id}-add-repo`, label: gettext('Add Library'), onClick: () => toggleAddLibrary(node) });
     items.push({ key: `${node.id}-set-quota`, label: gettext('Set quota'), onClick: () => toggleSetQuotaDialog(node) });
   }
   items.push({ key: `${node.id}-id`, label: `${gettext('Department ID')} : ${node.id}`, disabled: true });
diff --git a/frontend/src/pages/sys-admin/departments/index.js b/frontend/src/pages/sys-admin/departments/index.js
index 5b1bc074..7cd9e1bd 100644
--- a/frontend/src/pages/sys-admin/departments/index.js
+++ b/frontend/src/pages/sys-admin/departments/index.js
@@ -508,7 +508,9 @@ class Departments extends React.Component {
             setRootNode={this.setRootNode}
           />
         }
-        {this.state.isShowAddRepoDialog && (
+        {/* [dev] 0014: 部门资料库（组属主库）是 Pro C 核心能力，CE 无
+            add_group_owned_repo——建库对话框一并按 isPro 兜底隐藏（菜单入口已过滤） */}
+        {this.state.isShowAddRepoDialog && isPro && (
           <AddRepoDialog
             toggle={this.toggleAddLibrary}
             onAddNewRepo={() => {this.setState({ isAddNewRepo: !this.state.isAddNewRepo });}}
