From f976220ad946546dce12666cde8784c1dd45db6d Mon Sep 17 00:00:00 2001
From: topiceyes <273286342+topiceyes@users.noreply.github.com>
Date: Thu, 17 Sep 2026 14:19:59 +0800
Subject: [PATCH 07/10] Make DingTalk login 'invalid state' error diagnosable

The opaque 'Error, please contact administrator.' hid the common cause:
browsing the site on a host that differs from SERVICE_URL (e.g.
localhost vs 127.0.0.1), so the DingTalk redirect lands on another
origin and the session cookie (holding the OAuth state) is lost.
Log the received/expected state and the request host, and surface an
actionable message to the user.
---
 seahub/dingtalk/views.py | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/seahub/dingtalk/views.py b/seahub/dingtalk/views.py
index 558f141..d7babde 100644
--- a/seahub/dingtalk/views.py
+++ b/seahub/dingtalk/views.py
@@ -299,8 +299,13 @@ def dingtalk_callback_new(request):
 
     state = request.GET.get('state', '')
     if not state or state != request.session.get('dingtalk_login_state', ''):
-        logger.error('invalid state')
-        return render_error(request, _('Error, please contact administrator.'))
+        # [dev] 常见原因：访问站点的域名与 SERVICE_URL 不一致（如用 localhost 访问但
+        # SERVICE_URL 是 127.0.0.1），钉钉按 SERVICE_URL 回调导致 session cookie 丢失。
+        logger.error('invalid dingtalk login state: got=%s expected=%s host=%s',
+                     state or '<empty>',
+                     request.session.get('dingtalk_login_state', '<none in session>'),
+                     request.get_host())
+        return render_error(request, _('Login session expired, or the URL you are using does not match the site URL (SERVICE_URL) configured for DingTalk login. Please open the site with the configured URL and try again.'))
 
     def get_oauth_access_token(code):
         """
