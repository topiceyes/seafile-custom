diff --git a/frontend/src/pages/sys-admin/web-settings/web-settings.js b/frontend/src/pages/sys-admin/web-settings/web-settings.js
index 13ebab6..30f226c 100644
--- a/frontend/src/pages/sys-admin/web-settings/web-settings.js
+++ b/frontend/src/pages/sys-admin/web-settings/web-settings.js
@@ -318,6 +318,33 @@ class WebSettings extends Component {
                   />
                 </Section>
 
+                <Section headingText={gettext('DingTalk Login')}>
+                  <Fragment>
+                    <CheckboxItem
+                      saveSetting={this.saveSetting}
+                      displayName={gettext('Enable DingTalk login')}
+                      keyText='ENABLE_DINGTALK'
+                      value={config_dict['ENABLE_DINGTALK']}
+                      helpTip={gettext('Allow users to log in by scanning DingTalk QR code.')}
+                    />
+                    <InputItem
+                      saveSetting={this.saveSetting}
+                      displayName={gettext('DingTalk AppKey')}
+                      keyText='DINGTALK_APP_KEY'
+                      value={config_dict['DINGTALK_APP_KEY']}
+                      helpTip={gettext('AppKey of the DingTalk enterprise internal app')}
+                    />
+                    <InputItem
+                      inputType="password"
+                      saveSetting={this.saveSetting}
+                      displayName={gettext('DingTalk AppSecret')}
+                      keyText='DINGTALK_APP_SECRET'
+                      value={config_dict['DINGTALK_APP_SECRET']}
+                      helpTip={gettext('AppSecret of the DingTalk enterprise internal app')}
+                    />
+                  </Fragment>
+                </Section>
+
                 {isPro &&
                 <Section headingText={gettext('Terms')}>
                   <CheckboxItem
