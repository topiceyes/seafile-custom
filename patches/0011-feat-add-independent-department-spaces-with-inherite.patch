@@ -0,0 +1,47 @@
+"""Pure directory validation and role calculation; no database or RPC side effects."""
+
+
+class InvalidDirectory(ValueError):
+    pass
+
+
+def validate_snapshot(snapshot):
+    if not snapshot or '1' not in snapshot or len(snapshot) < 2:
+        raise InvalidDirectory('Empty or incomplete department tree')
+    for dept_id, dept in snapshot.items():
+        if str(dept_id) != dept_id or not dept.get('name'):
+            raise InvalidDirectory('Invalid department identifier or name')
+        if not isinstance(dept.get('members'), dict) or not isinstance(dept.get('managers'), dict):
+            raise InvalidDirectory('Missing member or manager list for %s' % dept_id)
+        seen = set()
+        current = dept_id
+        while current != '1':
+            if current in seen:
+                raise InvalidDirectory('Department cycle at %s' % current)
+            seen.add(current)
+            if current not in snapshot:
+                raise InvalidDirectory('Missing parent department %s' % current)
+            current = str(snapshot[current].get('parent_id', ''))
+        for uid, identity in {**dept['members'], **dept['managers']}.items():
+            if not uid or not isinstance(identity, dict):
+                raise InvalidDirectory('Missing union ID or identity in %s' % dept_id)
+
+
+def effective_roles(snapshot):
+    validate_snapshot(snapshot)
+    result = {}
+    for dept_id, dept in snapshot.items():
+        if dept_id == '1':
+            continue
+        roles = {uid: {'role': 'member', 'sources': [dept_id]}
+                 for uid in dept['members']}
+        current = dept_id
+        while current:
+            for uid in snapshot[current]['managers']:
+                entry = roles.setdefault(uid, {'role': 'manager', 'sources': []})
+                entry['role'] = 'manager'
+                if current not in entry['sources']:
+                    entry['sources'].append(current)
+            current = '' if current == '1' else str(snapshot[current]['parent_id'])
+        result[dept_id] = roles
+    return result
