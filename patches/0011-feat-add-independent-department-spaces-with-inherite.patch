+def directory():
+    def dept(name, parent, members=(), managers=()):
+        identity = lambda uid: {'name': uid, 'userid': 'ding-' + uid}
+        return {'name': name, 'parent_id': parent,
+                'members': {uid: identity(uid) for uid in members},
+                'managers': {uid: identity(uid) for uid in managers}}
+    return {'1': dept('Company', ''),
+            '2': dept('Engineering', '1', ['parent-member'], ['director']),
+            '3': dept('Platform', '2', ['alice'], ['lead']),
+            '4': dept('Applications', '2', ['bob']),
+            '5': dept('Finance', '1', ['carol'], ['finance-director'])}
+
+
+ACCOUNTS = {name: name + '@example.test' for name in (
+    'parent-member', 'director', 'alice', 'lead', 'bob', 'carol', 'finance-director')}
