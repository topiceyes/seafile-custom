+class PolicyTests(SimpleTestCase):
+    def test_supervisors_inherit_downwards_but_members_do_not(self):
+        roles = effective_roles(directory())
+        self.assertEqual(roles['3']['director']['role'], 'manager')
+        self.assertEqual(roles['3']['lead']['role'], 'manager')
+        self.assertEqual(roles['3']['alice']['role'], 'member')
+        self.assertNotIn('parent-member', roles['3'])
