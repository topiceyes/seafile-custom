+from datetime import timedelta
+
+from django.utils import timezone
+from rest_framework.authentication import BaseAuthentication, SessionAuthentication
+from rest_framework.exceptions import NotFound, PermissionDenied, ValidationError
+from rest_framework.permissions import IsAuthenticated
+from rest_framework.response import Response
+from rest_framework.views import APIView
+
+from .models import AccessGrant, AuditEvent, Department, Membership, Space, SyncRun
+
+
+class NativeTokenAuthentication(BaseAuthentication):
+    def authenticate(self, request):
+        if not request.META.get('HTTP_AUTHORIZATION'):
+            return None
+        from seahub.api2.authentication import TokenAuthentication
+        return TokenAuthentication().authenticate(request)
+
+
+def can_manage(user, space):
+    return bool(user.is_staff or AccessGrant.objects.filter(
+        space=space, username=user.username, desired=True, role='manager').exists())
+
+
+def get_space(user, space_id):
+    try:
+        space = Space.objects.select_related('department').get(pk=space_id)
+    except Space.DoesNotExist:
+        raise NotFound()
+    if not user.is_staff and not AccessGrant.objects.filter(
+            space=space, username=user.username, desired=True).exists():
+        raise NotFound()
+    return space
+
+
+def serialize_space(space, user, grant=None):
+    return {'id': space.pk, 'department_id': space.department.external_id,
+            'parent_department_id': space.department.parent_external_id,
+            'name': space.department.name, 'description': space.description,
+            'state': space.state, 'repo_id': space.repo_id,
+            'role': grant.role if grant else 'system_admin',
+            'sources': grant.sources if grant else [],
+            'can_manage': can_manage(user, space),
+            'access_ready': bool(grant and grant.applied and grant.desired),
+            'error': bool(space.error or (grant and grant.error))}
+
+
+class SpaceAPIView(APIView):
+    authentication_classes = (NativeTokenAuthentication, SessionAuthentication)
+    permission_classes = (IsAuthenticated,)
+
+
+class SpacesView(SpaceAPIView):
+    def get(self, request):
+        grants = {g.space_id: g for g in AccessGrant.objects.filter(
+            username=request.user.username, desired=True)}
+        spaces = Space.objects.select_related('department')
+        if not request.user.is_staff:
+            spaces = spaces.filter(pk__in=grants)
+        last = SyncRun.objects.filter(state='success').order_by('-finished_at').first()
+        return Response({'spaces': [serialize_space(s, request.user, grants.get(s.pk))
+                                    for s in spaces.order_by('department__name')],
+                         'last_success': last.finished_at if last else None,
+                         'sync_overdue': not last or timezone.now() - last.finished_at > timedelta(hours=2)})
+
+
+class SpaceDetailView(SpaceAPIView):
+    def get(self, request, space_id):
+        space = get_space(request.user, space_id)
+        grant = AccessGrant.objects.filter(space=space, username=request.user.username, desired=True).first()
+        result = serialize_space(space, request.user, grant)
+        result['members'] = list(Membership.objects.filter(department=space.department).values(
+            'name', 'is_member', 'is_manager'))
+        # External union IDs and service-account identities are not UI identities.
+        result['managers'] = []
+        ancestors = set()
+        current = space.department
+        while current and current.external_id not in ancestors:
+            ancestors.add(current.external_id)
+            current = Department.objects.filter(external_id=current.parent_external_id, active=True).first()
+        seen_managers = set()
+        for manager in Membership.objects.filter(
+                department__external_id__in=ancestors, is_manager=True).select_related('department'):
+            if manager.union_id in seen_managers:
+                continue
+            seen_managers.add(manager.union_id)
+            result['managers'].append({'name': manager.name,
+                                        'source_department': manager.department.name,
+                                        'inherited': manager.department_id != space.department_id})
+        result['last_success'] = SyncRun.objects.filter(state='success').order_by(
+            '-finished_at').values_list('finished_at', flat=True).first()
+        from .legacy import list_legacy_libraries
+        result['legacy_libraries'] = list_legacy_libraries(space, request.user.username)
+        return Response(result)
+
+    def patch(self, request, space_id):
+        space = get_space(request.user, space_id)
+        if not can_manage(request.user, space):
+            raise PermissionDenied()
+        if set(request.data) != {'description'}:
+            raise ValidationError('Only the space description is editable; organization data comes from DingTalk.')
+        description = request.data['description']
+        if not isinstance(description, str) or len(description) > 1000:
+            raise ValidationError('Description must contain at most 1000 characters.')
+        previous = space.description
+        space.description = description.strip()
+        space.save(update_fields=('description',))
+        AuditEvent.objects.create(space=space, actor=request.user.username,
+                                  action='update_description',
+                                  detail={'before': previous, 'after': space.description})
+        return Response({'description': space.description})
+
+
+class SpaceRestoreView(SpaceAPIView):
+    def post(self, request, space_id):
+        import re
+        space = get_space(request.user, space_id)
+        if not can_manage(request.user, space) or space.state != 'active':
+            raise PermissionDenied()
+        commit_id = request.data.get('commit_id', '')
+        path = request.data.get('path', '')
+        kind = request.data.get('type')
+        if (not re.fullmatch(r'[a-f0-9]{40}', str(commit_id)) or not isinstance(path, str)
+                or not path.startswith('/') or path == '/' or '..' in path.split('/')
+                or kind not in ('file', 'dir')):
+            raise ValidationError('Invalid restore target.')
+        from seaserv import seafile_api
+        method = seafile_api.revert_file if kind == 'file' else seafile_api.revert_dir
+        result = method(space.repo_id, commit_id, path, request.user.username)
+        if result not in (None, 0):
+            raise ValidationError('Unable to restore the selected item.')
+        AuditEvent.objects.create(space=space, actor=request.user.username, action='restore',
+                                  detail={'commit_id': commit_id, 'path': path, 'type': kind})
+        return Response({'success': True})
+
+
+class SpaceTrashView(SpaceAPIView):
+    def get(self, request, space_id):
+        import posixpath
+        import stat
+        space = get_space(request.user, space_id)
+        if not can_manage(request.user, space) or space.state != 'active':
+            raise PermissionDenied()
+        from seaserv import seafile_api
+        scan_stat = request.GET.get('scan_stat')
+        entries = seafile_api.get_deleted(space.repo_id, 90, '/', scan_stat)
+        if not entries:
+            return Response({'items': [], 'next_scan_stat': None})
+        items = [{'path': posixpath.join(item.basedir, item.obj_name),
+                  'type': 'dir' if stat.S_ISDIR(item.mode) else 'file',
+                  'commit_id': item.commit_id, 'deleted_time': item.delete_time}
+                 for item in entries[:-1]]
+        return Response({'items': items, 'next_scan_stat': entries[-1].scan_stat})
