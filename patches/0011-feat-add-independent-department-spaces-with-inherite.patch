+import json
+
+from django.http import JsonResponse
+from django.utils.deprecation import MiddlewareMixin
+
+from .models import Space
+
+
+class SpacePolicyMiddleware(MiddlewareMixin):
+    """Guard old sharing endpoints. Singular upload-link is file transfer, not public sharing."""
+    def process_view(self, request, view_func, view_args, view_kwargs):
+        if request.method not in ('POST', 'PUT', 'PATCH', 'DELETE'):
+            return
+        path = request.path_info
+        sensitive = any(part in path for part in (
+            '/share-links/', '/multi-share-links/', '/upload-links/', '/shared-repos/',
+            '/shared-items/', '/shared_items/', '/user-share/', '/group-share/',
+            '/repo-api-token', '/api-tokens/', '/owner/', '/transfer/'))
+        if not sensitive:
+            return
+        ids = {str(view_kwargs.get('repo_id', ''))}
+        ids.update(request.GET.getlist('repo_id'))
+        if request.content_type == 'application/json':
+            try:
+                data = json.loads(request.body)
+            except (ValueError, UnicodeDecodeError):
+                return
+        else:
+            data = request.POST
+        if isinstance(data, dict) or hasattr(data, 'get'):
+            ids.add(str(data.get('repo_id', '')))
+            batch = data.get('repo_ids', [])
+            if isinstance(batch, list):
+                ids.update(str(value) for value in batch)
+        if Space.objects.filter(repo_id__in=ids).exists():
+            return JsonResponse({'error_msg': '部门资料由组织统一授权，暂不允许外链、再共享或转移所有权。'}, status=403)
