diff --git a/frontend/src/pages/app/main-panel/department-spaces/index.js b/frontend/src/pages/app/main-panel/department-spaces/index.js
new file mode 100644
index 00000000..6147a21b
--- /dev/null
+++ b/frontend/src/pages/app/main-panel/department-spaces/index.js
@@ -0,0 +1,179 @@
+import React, { useEffect, useState } from 'react';
+import { Link } from '@gatsbyjs/reach-router';
+import PropTypes from 'prop-types';
+import { seafileAPI } from '@/api/seafile-api';
+import Loading from '@/components/loading';
+import { gettext, siteRoot } from '@/utils/constants';
+import { Utils } from '@/utils/utils';
+
+function DepartmentSpaces({ spaceID }) {
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+  const [spaces, setSpaces] = useState([]);
+  const [detail, setDetail] = useState(null);
+  const [description, setDescription] = useState('');
+  const [saving, setSaving] = useState(false);
+  const [syncOverdue, setSyncOverdue] = useState(false);
+  const [query, setQuery] = useState('');
+  const [trash, setTrash] = useState(null);
+
+  useEffect(() => {
+    let mounted = true;
+    setLoading(true);
+    setError('');
+    setTrash(null);
+    Promise.all([
+      seafileAPI.listDepartmentSpaces(),
+      spaceID ? seafileAPI.getDepartmentSpace(spaceID) : Promise.resolve(null)
+    ]).then(([list, selected]) => {
+      if (!mounted) return;
+      setSpaces(list.data.spaces);
+      setSyncOverdue(list.data.sync_overdue);
+      setDetail(selected ? selected.data : null);
+      setDescription(selected ? selected.data.description : '');
+      setLoading(false);
+    }).catch(err => {
+      if (!mounted) return;
+      setError(Utils.getErrorMsg(err, true));
+      setLoading(false);
+    });
+    return () => { mounted = false; };
+  }, [spaceID]);
+
+  const save = async () => {
+    setSaving(true);
+    try {
+      await seafileAPI.updateDepartmentSpace(spaceID, { description });
+      setDetail({ ...detail, description });
+      setError('');
+    } catch (err) {
+      setError(Utils.getErrorMsg(err, true));
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  const loadTrash = async (append = false) => {
+    try {
+      const res = await seafileAPI.getDepartmentSpaceTrash(spaceID, append && trash ? trash.next_scan_stat : null);
+      setTrash(append ? { ...res.data, items: [...trash.items, ...res.data.items] } : res.data);
+    } catch (err) {
+      setError(Utils.getErrorMsg(err, true));
+    }
+  };
+
+  const restore = async item => {
+    setSaving(true);
+    try {
+      await seafileAPI.restoreDepartmentSpaceItem(spaceID, {
+        commit_id: item.commit_id, path: item.path, type: item.type
+      });
+      await loadTrash();
+      setError('');
+    } catch (err) {
+      setError(Utils.getErrorMsg(err, true));
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  const parentName = space => {
+    const names = [];
+    let current = space;
+    const visited = new Set();
+    while (current && !visited.has(current.id)) {
+      visited.add(current.id);
+      names.unshift(current.name);
+      current = spaces.find(s => s.department_id === current.parent_department_id);
+    }
+    return names.join(' / ');
+  };
+
+  return (
+    <div className="main-panel-center flex-row">
+      <div className="cur-view-container">
+        <div className="cur-view-path">
+          <Link to={`${siteRoot}department-spaces/`}>{gettext('Department sharing')}</Link>
+          {detail && <span> / {detail.name}</span>}
+        </div>
+        <div className="cur-view-content p-4">
+          {error && <div className="alert alert-danger" role="alert">{error}</div>}
+          {loading ? <Loading /> : (
+            <>
+              {syncOverdue && <div className="alert alert-warning">{gettext('Directory information has not been refreshed in over two hours. Contact your administrator.')}</div>}
+              {!detail && (
+                <>
+                  <p>{gettext('Members access their own departments. Managers also manage all descendant departments.')}</p>
+                  <label className="d-block">{gettext('Find a department')}
+                    <input className="form-control mt-2" value={query} onChange={e => setQuery(e.target.value)} placeholder={gettext('Enter a department name')} />
+                  </label>
+                  {spaces.length === 0 && <p className="text-muted mt-4">{gettext('No department spaces are available yet. They appear automatically after provisioning.')}</p>}
+                  <table className="table mt-3">
+                    <thead><tr><th>{gettext('Department')}</th><th>{gettext('My role')}</th><th>{gettext('Status')}</th></tr></thead>
+                    <tbody>{spaces.filter(s => parentName(s).includes(query)).map(space => (
+                      <tr key={space.id}>
+                        <td><Link to={`${siteRoot}department-spaces/${space.id}/`}>{parentName(space)}</Link></td>
+                        <td>{space.role === 'manager' ? gettext('Manager') : space.role === 'member' ? gettext('Member') : gettext('System administrator')}</td>
+                        <td>{space.state === 'archived' ? gettext('Archived') : space.error ? gettext('Synchronization needs attention') : space.access_ready ? gettext('Ready') : gettext('Access pending')}</td>
+                      </tr>
+                    ))}
+                    </tbody>
+                  </table>
+                </>
+              )}
+              {detail && (
+                <>
+                  <h3>{detail.name} · {gettext('Shared files')}</h3>
+                  <p>{detail.description || gettext('Shared department files remain with the department.')}</p>
+                  {detail.access_ready && detail.state === 'active' && (
+                    <Link className="btn btn-primary mb-4" to={`${siteRoot}library/${detail.repo_id}/`}>{gettext('Open department library')}</Link>
+                  )}
+                  {!detail.access_ready && <p className="text-muted">{gettext('File access requires an applied member or manager grant. Administrators can inspect space status separately.')}</p>}
+                  {detail.legacy_libraries.length > 0 && (
+                    <>
+                      <h4>{gettext('Previously shared libraries')}</h4>
+                      <p className="text-muted">{gettext('These libraries retain their original owners and permissions and have not been transferred to the department.')}</p>
+                      <ul>{detail.legacy_libraries.map(repo => (
+                        <li key={repo.repo_id}><Link to={`${siteRoot}library/${repo.repo_id}/`}>{repo.name}</Link></li>
+                      ))}
+                      </ul>
+                    </>
+                  )}
+                  <h4>{gettext('Space managers')}</h4>
+                  <ul>{detail.managers.map((manager, index) => <li key={index}>{manager.name} · {manager.inherited ? gettext('Ancestor department manager') : gettext('Department manager')}</li>)}</ul>
+                  <h4>{gettext('Direct members')}</h4>
+                  <ul>{detail.members.filter(m => m.is_member).map((member, index) => <li key={index}>{member.name || gettext('Name pending')}{member.is_manager ? ` · ${gettext('Manager')}` : ''}</li>)}</ul>
+                  {detail.can_manage && (
+                    <>
+                      <h4 className="mt-4">{gettext('Space management')}</h4>
+                      <label className="d-block">{gettext('Space description')}
+                        <textarea className="form-control mt-2" maxLength={1000} rows={3} value={description} onChange={e => setDescription(e.target.value)} />
+                      </label>
+                      <button type="button" className="btn btn-primary" disabled={saving || description === detail.description} onClick={save}>{saving ? gettext('Processing…') : gettext('Save description')}</button>
+                      <button type="button" className="btn btn-secondary ml-2" disabled={saving || detail.state !== 'active'} onClick={() => loadTrash()}>{gettext('View trash')}</button>
+                    </>
+                  )}
+                  {trash && (
+                    <>
+                      <table className="table mt-4">
+                        <thead><tr><th>{gettext('Deleted item')}</th><th>{gettext('Action')}</th></tr></thead>
+                        <tbody>{trash.items.map((item, index) => (
+                          <tr key={index}><td>{item.path}</td><td><button type="button" className="btn btn-secondary btn-sm" disabled={saving} onClick={() => restore(item)}>{gettext('Restore')}</button></td></tr>
+                        ))}
+                        </tbody>
+                      </table>
+                      {trash.next_scan_stat && <button type="button" className="btn btn-secondary" onClick={() => loadTrash(true)}>{gettext('Load more')}</button>}
+                    </>
+                  )}
+                </>
+              )}
+            </>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+DepartmentSpaces.propTypes = { spaceID: PropTypes.string };
+export default DepartmentSpaces;
