+import fcntl
+import json
+import os
+import tempfile
+
+from django.core.management.base import BaseCommand, CommandError
+from django.utils import timezone
+
+from ...directory import fetch_snapshot
+from ...services import reconcile_access, sync_directory
+from ...models import SyncRun
+
+
+class Command(BaseCommand):
+    help = 'Sync independent DingTalk department spaces, supervisors and CE user shares.'
+
+    def add_arguments(self, parser):
+        parser.add_argument('--dry-run', action='store_true')
+        parser.add_argument('--reconcile-only', action='store_true')
+        parser.add_argument('--allow-large-changes', action='store_true',
+                            help='Explicitly accept a reviewed change exceeding the 25%% removal threshold.')
+
+    def handle(self, *args, **options):
+        if options['dry_run'] and options['reconcile_only']:
+            raise CommandError('--dry-run and --reconcile-only cannot be combined')
+        fd = os.open(os.path.join(tempfile.gettempdir(), 'seafile-department-spaces.lock'),
+                     os.O_CREAT | os.O_RDWR, 0o600)
+        with os.fdopen(fd, 'w') as lock:
+            started = timezone.now()
+            try:
+                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except BlockingIOError:
+                raise CommandError('A department space sync is already running')
+            try:
+                if options['reconcile_only']:
+                    summary = {'errors': reconcile_access()}
+                else:
+                    snapshot = fetch_snapshot()
+                    summary = sync_directory(snapshot, dry_run=options['dry_run'],
+                                             allow_large_changes=options['allow_large_changes'])
+                    if not options['dry_run']:
+                        # Preserve the existing real-name backfill without writing any group.
+                        from seahub.dingtalk.management.commands.sync_dingtalk_departments import Command as Legacy
+                        names = {uid: value['name'] for dept in snapshot.values()
+                                 for uid, value in {**dept['members'], **dept['managers']}.items()}
+                        legacy = Legacy()
+                        legacy.dry_run = False
+                        legacy._sync_nicknames(names)
+                self.stdout.write(json.dumps(summary, ensure_ascii=False))
+                if summary.get('errors'):
+                    raise CommandError('Department access reconciliation is incomplete; rerun --reconcile-only')
+            except CommandError:
+                raise
+            except Exception as error:
+                if not options['dry_run'] and not SyncRun.objects.filter(started_at__gte=started).exists():
+                    SyncRun.objects.create(state='failed', finished_at=timezone.now(), error=str(error))
+                raise CommandError(str(error)) from error
