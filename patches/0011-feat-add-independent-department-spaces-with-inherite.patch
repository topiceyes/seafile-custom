+import uuid
+
+from django.db import models
+
+
+class Department(models.Model):
+    external_id = models.CharField(max_length=64, unique=True)
+    parent_external_id = models.CharField(max_length=64, blank=True)
+    name = models.CharField(max_length=255)
+    active = models.BooleanField(default=True)
+    updated_at = models.DateTimeField(auto_now=True)
+
+    class Meta:
+        ordering = ('name', 'external_id')
+
+
+class Membership(models.Model):
+    department = models.ForeignKey(Department, on_delete=models.CASCADE)
+    union_id = models.CharField(max_length=255)
+    userid = models.CharField(max_length=255, blank=True)
+    name = models.CharField(max_length=64, blank=True)
+    is_member = models.BooleanField(default=False)
+    is_manager = models.BooleanField(default=False)
+
+    class Meta:
+        constraints = [models.UniqueConstraint(
+            fields=('department', 'union_id'), name='deptspace_membership_unique')]
+
+
+class Space(models.Model):
+    department = models.OneToOneField(Department, on_delete=models.PROTECT)
+    provision_id = models.UUIDField(default=uuid.uuid4, unique=True, editable=False)
+    owner = models.CharField(max_length=255, blank=True)
+    repo_id = models.CharField(max_length=36, null=True, blank=True, unique=True)
+    description = models.CharField(max_length=1000, blank=True)
+    state = models.CharField(max_length=24, default='pending')
+    error = models.TextField(blank=True)
+
+
+class AccessGrant(models.Model):
+    space = models.ForeignKey(Space, on_delete=models.CASCADE)
+    username = models.CharField(max_length=255)
+    role = models.CharField(max_length=16, default='member')
+    sources = models.JSONField(default=list)
+    desired = models.BooleanField(default=True)
+    applied = models.BooleanField(default=False)
+    error = models.TextField(blank=True)
+
+    class Meta:
+        constraints = [models.UniqueConstraint(
+            fields=('space', 'username'), name='deptspace_access_unique')]
+
+
+class SyncRun(models.Model):
+    started_at = models.DateTimeField(auto_now_add=True)
+    finished_at = models.DateTimeField(null=True)
+    state = models.CharField(max_length=24, default='running')
+    summary = models.JSONField(default=dict)
+    error = models.TextField(blank=True)
