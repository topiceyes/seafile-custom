+++ b/seahub/department_spaces/services.py
@@ -0,0 +1,191 @@
+import logging
+
+from django.conf import settings
+from django.db import transaction
+from django.utils import timezone
+
+from .backend import SeafileBackend, resolve_accounts
+from .models import AccessGrant, AuditEvent, Department, Membership, Space, SyncRun
+from .policy import InvalidDirectory, effective_roles, validate_snapshot
+
+logger = logging.getLogger(__name__)
+
+
+def snapshot_from_database():
+    snapshot = {d.external_id: {'name': d.name, 'parent_id': d.parent_external_id,
+                               'members': {}, 'managers': {}}
+                for d in Department.objects.filter(active=True)}
+    for m in Membership.objects.filter(department__active=True).select_related('department'):
+        dept = snapshot[m.department.external_id]
+        value = {'userid': m.userid, 'name': m.name}
+        if m.is_member:
+            dept['members'][m.union_id] = value
+        if m.is_manager:
+            dept['managers'][m.union_id] = value
+    return snapshot
+
+
+def _desired_access(snapshot, accounts):
+    desired = {}
+    for dept_id, roles in effective_roles(snapshot).items():
+        users = desired.setdefault(dept_id, {})
+        for uid, role in roles.items():
+            if uid not in accounts:
+                continue
+            entry = users.setdefault(accounts[uid], {'role': 'member', 'sources': []})
+            if role['role'] == 'manager':
+                entry['role'] = 'manager'
+            entry['sources'] = sorted(set(entry['sources']) | set(role['sources']))
+    return desired
+
+
+def sync_directory(snapshot, backend=None, accounts=None, dry_run=False, actor='directory-sync', allow_large_changes=False):
+    validate_snapshot(snapshot)
+    union_ids = set().union(*(set(d['members']) | set(d['managers']) for d in snapshot.values()))
+    accounts = resolve_accounts(union_ids) if accounts is None else accounts
+    desired = _desired_access(snapshot, accounts)
+    old_departments = Department.objects.filter(active=True).exclude(external_id='1').count()
+    old_members = Membership.objects.filter(is_member=True, department__active=True).count()
+    new_members = sum(len(d['members']) for d in snapshot.values())
+    # A narrowed contact permission scope may return a valid but partial directory.
+    ratio = 1.0 if allow_large_changes else getattr(settings, 'DEPARTMENT_SPACES_MAX_REMOVAL_RATIO', 0.25)
+    if old_departments and (old_departments - (len(snapshot) - 1)) / old_departments > ratio:
+        raise InvalidDirectory('Department count dropped beyond the safety threshold')
+    if old_members and (old_members - new_members) / old_members > ratio:
+        raise InvalidDirectory('Directory membership count dropped beyond the safety threshold')
+    current = set(AccessGrant.objects.filter(desired=True).values_list(
+        'space__department__external_id', 'username'))
+    target = {(dept, username) for dept, users in desired.items() for username in users}
+    if current and len(current - target) / len(current) > ratio:
+        raise InvalidDirectory('Access revocation count exceeds the safety threshold')
+    summary = {'departments': len(snapshot) - 1, 'memberships': new_members,
+               'access': len(target), 'grant': len(target - current),
+               'revoke': len(current - target), 'pending_identities': len(union_ids - set(accounts))}
+    if dry_run:
+        return summary
+
+    run = SyncRun.objects.create()
+    try:
+        with transaction.atomic():
+            # Serialize directory publication against first-login compensation.
+            Department.objects.select_for_update().filter(external_id='1').first()
+            Department.objects.exclude(external_id__in=snapshot).update(active=False)
+            for dept_id, data in snapshot.items():
+                dept, _ = Department.objects.update_or_create(external_id=dept_id, defaults={
+                    'name': data['name'], 'parent_external_id': str(data['parent_id']), 'active': True})
+                identities = {**data['members'], **data['managers']}
+                Membership.objects.filter(department=dept).exclude(union_id__in=identities).delete()
+                for uid, identity in identities.items():
+                    Membership.objects.update_or_create(department=dept, union_id=uid, defaults={
+                        'userid': identity.get('userid', ''), 'name': identity.get('name', ''),
+                        'is_member': uid in data['members'], 'is_manager': uid in data['managers']})
+                if dept_id != '1':
+                    Space.objects.get_or_create(department=dept)
+            # Retired spaces keep their files and are explicitly marked for archival.
+            Space.objects.filter(department__active=False).update(state='archived')
+            AccessGrant.objects.update(desired=False)
+            for space in Space.objects.filter(department__active=True).select_related('department'):
+                for username, role in desired.get(space.department.external_id, {}).items():
+                    AccessGrant.objects.update_or_create(space=space, username=username, defaults={
+                        'desired': True, 'role': role['role'], 'sources': role['sources']})
+        actual_backend = backend or SeafileBackend()
+        if hasattr(actual_backend, 'sync_legacy_members'):
+            actual_backend.sync_legacy_members(snapshot, accounts)
+        summary['errors'] = reconcile_access(backend=actual_backend)
+        run.state = 'failed' if summary['errors'] else 'success'
+        run.summary = summary
+        AuditEvent.objects.create(actor=actor, action='sync', detail=summary)
+    except Exception as error:
+        run.state = 'failed'
+        run.error = str(error)
+        raise
+    finally:
+        run.finished_at = timezone.now()
+        run.save()
+    return summary
+
+
+def reconcile_access(backend=None, username=None):
+    backend = backend or SeafileBackend()
+    errors = 0
+    # Revoke first, including grants left unapplied by an interrupted earlier run.
+    grants = AccessGrant.objects.select_related('space__department')
+    if username:
+        grants = grants.filter(username=username)
+    for candidate in grants.filter(desired=False):
+        with transaction.atomic():
+            grant = AccessGrant.objects.select_for_update().select_related('space').get(pk=candidate.pk)
+            if grant.desired:
+                continue
+            try:
+                if grant.space.repo_id:
+                    backend.revoke(grant.space, grant.username)
+                grant.applied = False
+                grant.error = ''
+            except Exception as error:
+                grant.error = str(error)
+                errors += 1
+            grant.save(update_fields=('applied', 'error'))
+    # Do not introduce new grants while revocations failed.
+    if errors:
+        return errors
+    spaces = Space.objects.filter(department__active=True).select_related('department')
+    if username:
+        spaces = spaces.filter(accessgrant__username=username, accessgrant__desired=True).distinct()
+    for candidate in spaces:
+        try:
+            # Serialize provisioning, including login compensation, on the space row.
+            with transaction.atomic():
+                space = Space.objects.select_for_update().select_related('department').get(pk=candidate.pk)
+                space.owner = space.owner or backend.ensure_owner(space.provision_id)
+                space.save(update_fields=('owner',))
+                space.repo_id = backend.ensure_repo(space)
+                space.state, space.error = 'active', ''
+                space.save(update_fields=('repo_id', 'state', 'error'))
+        except Exception as error:
+            Space.objects.filter(pk=candidate.pk).update(state='degraded', error=str(error))
+            errors += 1
+            continue
+        pending = AccessGrant.objects.filter(space=space, desired=True)
+        if username:
+            pending = pending.filter(username=username)
+        for candidate_grant in pending:
+            with transaction.atomic():
+                grant = AccessGrant.objects.select_for_update().get(pk=candidate_grant.pk)
+                if not grant.desired:
+                    continue
+                try:
+                    # Reassert shares even when marked applied: repair drift in the core.
+                    backend.grant(space, grant.username)
+                    grant.applied, grant.error = True, ''
+                except Exception as error:
+                    grant.applied, grant.error = False, str(error)
+                    errors += 1
+                grant.save(update_fields=('applied', 'error'))
+        if AccessGrant.objects.filter(space=space, desired=True).exclude(error='').exists():
+            Space.objects.filter(pk=space.pk).update(state='degraded', error='Member access reconciliation requires retry')
+    return errors
+
+
+def compensate_login(username):
+    """Grant a newly bound account using the last complete directory snapshot."""
+    from seahub.auth.models import SocialAuthUser
+    if not Department.objects.exists():
+        return
+    bindings = list(SocialAuthUser.objects.filter(provider='dingtalk', username=username))
+    uids = {b.uid for b in bindings if b.provider == 'dingtalk'}
+    with transaction.atomic():
+        Department.objects.select_for_update().filter(external_id='1').first()
+        snapshot = snapshot_from_database()
+        roles = effective_roles(snapshot)
+        AccessGrant.objects.filter(username=username).update(desired=False)
+        for space in Space.objects.filter(department__active=True).select_related('department'):
+            matches = [role for uid, role in roles.get(space.department.external_id, {}).items() if uid in uids]
+            if not matches:
+                continue
+            AccessGrant.objects.update_or_create(space=space, username=username, defaults={
+                'desired': True,
+                'role': 'manager' if any(r['role'] == 'manager' for r in matches) else 'member',
+                'sources': sorted(set().union(*(set(r['sources']) for r in matches)))})
+    if reconcile_access(username=username):
+        logger.error('Department access login compensation requires retry')
