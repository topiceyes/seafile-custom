+from django.apps import AppConfig
+
+
+class DepartmentSpacesConfig(AppConfig):
+    name = 'seahub.department_spaces'
+    default_auto_field = 'django.db.models.AutoField'
+
+    def ready(self):
+        from django.apps import apps
+        from django.db.models.signals import pre_save
+        from .signals import deny_public_credentials, on_login
+        for app, model in (('share', 'FileShare'), ('share', 'UploadLinkShare'),
+                           ('repo_api_tokens', 'RepoAPITokens')):
+            if apps.is_installed('seahub.' + app):
+                pre_save.connect(deny_public_credentials, sender=apps.get_model(app, model),
+                                 dispatch_uid='department_spaces.protect.' + model)
+        if apps.is_installed('seahub.base'):
+            from seahub.auth.signals import user_logged_in
+            user_logged_in.connect(on_login, dispatch_uid='department_spaces.login')
diff --git a/seahub/department_spaces/backend.py b/seahub/department_spaces/backend.py
new file mode 100644
index 00000000..c86e7864
--- /dev/null
+++ b/seahub/department_spaces/backend.py
@@ -0,0 +1,84 @@
+"""CE adapter: ordinary libraries and per-user shares, without department groups."""
+import secrets
+
+
+class SeafileBackend:
+    def sync_legacy_members(self, snapshot, accounts):
+        from .legacy import sync_existing_members
+        sync_existing_members(snapshot, accounts)
+
+    def ensure_owner(self, provision_id):
+        from seahub.base.accounts import User
+        username = 'department-space-%s@system.invalid' % provision_id
+        try:
+            user = User.objects.get(email=username)
+        except User.DoesNotExist:
+            user = User(email=username)
+            user.is_staff = False
+            user.is_active = True
+            user.set_password(secrets.token_urlsafe(48))
+            if user.save() != 0:
+                raise RuntimeError('Unable to create department custodian')
+        if user.is_staff or not user.is_active:
+            raise RuntimeError('Department custodian is inactive or unexpectedly has staff privileges')
+        return username
+
+    def ensure_repo(self, space):
+        from seaserv import seafile_api
+        from seahub.profile.models import Profile
+        # Native clients use the owner's profile for their shared-library label.
+        Profile.objects.add_or_update(username=space.owner,
+                                      nickname=space.department.name[:64],
+                                      list_in_address_book='false')
+        marker = 'department-space:%s' % space.provision_id
+        if space.repo_id:
+            repo = seafile_api.get_repo(space.repo_id)
+            if not repo or seafile_api.get_repo_owner(space.repo_id) != space.owner:
+                raise RuntimeError('Managed library is missing or its ownership changed')
+        else:
+            # CE's owned-library listing omits desc; read each library's details.
+            owned = [seafile_api.get_repo(r.id) for r in seafile_api.get_owned_repo_list(space.owner)]
+            candidates = [r for r in owned if r and r.desc == marker]
+            if len(candidates) > 1:
+                raise RuntimeError('Multiple libraries match department provisioning marker')
+            if candidates:
+                repo = candidates[0]
+            else:
+                repo_id = seafile_api.create_repo(space.department.name + '共享资料',
+                                                  marker, space.owner, None)
+                repo = seafile_api.get_repo(repo_id)
+                if not repo:
+                    raise RuntimeError('Library creation did not produce a library')
+        name = space.department.name + '共享资料'
+        if repo.name != name:
+            seafile_api.edit_repo(repo.id, name, marker, space.owner)
+        return repo.id
+
+    def grant(self, space, username, permission='rw'):
+        from seaserv import seafile_api
+        result = seafile_api.share_repo(space.repo_id, space.owner, username, permission)
+        if result not in (None, 0):
+            raise RuntimeError('Core rejected department share')
+
+    def revoke(self, space, username):
+        from seaserv import seafile_api
+        result = seafile_api.remove_share(space.repo_id, space.owner, username)
+        if result not in (None, 0):
+            raise RuntimeError('Core rejected department access revocation')
+
+
+def resolve_accounts(union_ids):
+    from seahub.auth.models import SocialAuthUser
+    from seahub.base.accounts import User
+    result = {}
+    # Exact matching after database lookup protects case-sensitive union IDs.
+    for binding in SocialAuthUser.objects.filter(provider='dingtalk', uid__in=union_ids):
+        if binding.uid not in union_ids or binding.provider != 'dingtalk':
+            continue
+        try:
+            user = User.objects.get(email=binding.username)
+        except User.DoesNotExist:
+            continue
+        if user.is_active:
+            result[binding.uid] = binding.username
+    return result
diff --git a/seahub/department_spaces/directory.py b/seahub/department_spaces/directory.py
new file mode 100644
index 00000000..66d2ebef
--- /dev/null
+++ b/seahub/department_spaces/directory.py
@@ -0,0 +1,111 @@
+"""Fetch a complete DingTalk snapshot before making any local changes."""
+import requests
+import time
+
+from .policy import InvalidDirectory, validate_snapshot
+
+BASE_URL = 'https://oapi.dingtalk.com/topapi/v2/'
+
+
+def _org_token():
+    from seahub.dingtalk.utils import dingtalk_get_orgapp_token
+    try:
+        return dingtalk_get_orgapp_token()
+    except requests.RequestException:
+        raise InvalidDirectory('DingTalk token request failed') from None
+
+
+def fetch_snapshot():
+    with requests.Session() as session:
+        return _fetch_snapshot(session)
+
+
+def _fetch_snapshot(session):
+    token = _org_token()
+    if not token:
+        raise InvalidDirectory('Unable to obtain DingTalk directory token')
+
+    def post(endpoint, body, result_type=dict):
+        for attempt in range(3):
+            try:
+                response = session.post(BASE_URL + endpoint,
+                                        params={'access_token': token}, json=body,
+                                        timeout=(5, 30))
+                response.raise_for_status()
+                data = response.json()
+                break
+            except (requests.RequestException, ValueError):
+                if attempt == 2:
+                    raise InvalidDirectory('%s request or response failed' % endpoint) from None
+                time.sleep(2 ** attempt)
+        if data.get('errcode') != 0 or not isinstance(data.get('result'), result_type):
+            # Never log request URLs, tokens or the full personnel response.
+            raise InvalidDirectory('%s failed (code %s)' % (endpoint, data.get('errcode')))
+        return data['result']
+
+    def department(dept_id):
+        result = post('department/get', {'dept_id': int(dept_id)})
+        if str(result.get('dept_id')) != dept_id or not result.get('name'):
+            raise InvalidDirectory('Incomplete department detail for %s' % dept_id)
+        # Real topapi v2 responses omit empty arrays (including the root's empty
+        # supervisor list). Normalize only after validating the detail envelope.
+        managers = result.get('dept_manager_userid_list', [])
+        if not isinstance(managers, list):
+            raise InvalidDirectory('Invalid supervisor list for department %s' % dept_id)
+        return result, [str(u) for u in managers]
+
+    identity_cache = {}
+
+    def identity(member):
+        userid = str(member.get('userid') or '')
+        union_id = str(member.get('unionid') or '')
+        if not userid or not union_id:
+            raise InvalidDirectory('Directory member is missing userid or unionid')
+        value = {'userid': userid, 'name': str(member.get('name') or '')[:64]}
+        identity_cache[userid] = (union_id, value)
+        return union_id, value
+
+    snapshot = {}
+    queue = ['1']
+    supervisor_ids = {}
+    while queue:
+        dept_id = queue.pop(0)
+        if dept_id in snapshot:
+            raise InvalidDirectory('Duplicate or cyclic department %s' % dept_id)
+        info, managers = department(dept_id)
+        members = {}
+        cursor = 0
+        visited_cursors = set()
+        while True:
+            if cursor in visited_cursors:
+                raise InvalidDirectory('Repeated member page cursor')
+            visited_cursors.add(cursor)
+            page = post('user/list', {'dept_id': int(dept_id), 'cursor': cursor, 'size': 100})
+            rows = page.get('list', [])
+            if (not isinstance(rows, list) or not isinstance(page.get('has_more'), bool)
+                    or (page['has_more'] and not rows)):
+                raise InvalidDirectory('Incomplete member page for department %s' % dept_id)
+            for member in rows:
+                uid, value = identity(member)
+                members[uid] = value
+            if not page['has_more']:
+                break
+            cursor = page.get('next_cursor')
+            if cursor is None:
+                raise InvalidDirectory('Missing next member cursor')
+        snapshot[dept_id] = {'name': str(info.get('name') or ''),
+                             'parent_id': str(info.get('parent_id') or ''),
+                             'members': members, 'managers': {}}
+        supervisor_ids[dept_id] = managers
+        # listsub has an array result, unlike the other topapi v2 endpoints.
+        children = post('department/listsub', {'dept_id': int(dept_id)}, list)
+        queue.extend(str(item['dept_id']) for item in children)
+
+    for dept_id, userids in supervisor_ids.items():
+        for userid in userids:
+            if userid not in identity_cache:
+                identity(post('user/get', {'userid': userid}))
+            uid, value = identity_cache[userid]
+            snapshot[dept_id]['managers'][uid] = value
+    validate_snapshot(snapshot)
+    return snapshot
diff --git a/seahub/department_spaces/legacy.py b/seahub/department_spaces/legacy.py
new file mode 100644
index 00000000..6c837e9f
--- /dev/null
+++ b/seahub/department_spaces/legacy.py
@@ -0,0 +1,56 @@
+"""Compatibility for existing personal libraries shared to old DingTalk groups.
+
+New spaces never create groups. Keep existing ACLs until library owners decide
+whether to transfer their personal libraries, but move their UI out of groups.
+"""
+from .models import Space
+
+
+def legacy_group_ids():
+    from seahub.auth.models import ExternalDepartment
+    dept_ids = set(Space.objects.values_list(
+        'department__external_id', flat=True))
+    return {m.group_id for m in ExternalDepartment.objects.filter(provider='dingtalk')
+            if str(m.outer_id) in dept_ids}
+
+
+def list_legacy_libraries(space, username):
+    from seaserv import seafile_api
+    from seahub.auth.models import ExternalDepartment
+    if not space.department.external_id.isdecimal():
+        return []  # The legacy schema only accepts numeric DingTalk department IDs.
+    mapping = ExternalDepartment.objects.get_by_provider_and_outer_id(
+        'dingtalk', space.department.external_id)
+    if not mapping:
+        return []
+    result = []
+    for repo in seafile_api.get_repos_by_group(mapping.group_id):
+        permission = seafile_api.check_permission(repo.id, username)
+        if permission:
+            result.append({'repo_id': repo.id, 'name': repo.name, 'permission': permission})
+    return result
+
+
+def sync_existing_members(snapshot, accounts):
+    from seaserv import ccnet_api
+    from seahub.auth.models import ExternalDepartment
+    from seahub.base.accounts import User
+    for mapping in ExternalDepartment.objects.filter(provider='dingtalk'):
+        data = snapshot.get(str(mapping.outer_id))
+        if not data:
+            # Removed departments remain a deliberate archival decision.
+            continue
+        group = ccnet_api.get_group(mapping.group_id)
+        if not group:
+            continue
+        target = {accounts[uid] for uid in data['members'] if uid in accounts}
+        current = {m.user_name for m in ccnet_api.get_group_members(mapping.group_id)}
+        for username in target - current:
+            ccnet_api.group_add_member(mapping.group_id, 'system admin', username)
+        for username in current - target:
+            try:
+                if User.objects.get(email=username).is_staff:
+                    continue  # Preserve pre-existing legacy administrator exceptions.
+            except User.DoesNotExist:
+                pass
+            ccnet_api.group_remove_member(mapping.group_id, 'system admin', username)
