+class FakeBackend:
+    def __init__(self):
+        self.calls = []
+        self.fail_revoke = False
+        self.fail_grant = False
+        self.libraries = {}
+
+    def ensure_owner(self, provision_id):
+        return 'custodian-%s@system.invalid' % provision_id
+
+    def ensure_repo(self, space):
+        return self.libraries.setdefault(str(space.provision_id), 'repo-%s' % space.pk)
+
+    def grant(self, space, username, permission='rw'):
+        self.calls.append(('grant', space.pk, username))
+        if self.fail_grant:
+            raise RuntimeError('test RPC grant failed')
+
+    def revoke(self, space, username):
+        self.calls.append(('revoke', space.pk, username))
+        if self.fail_revoke:
+            raise RuntimeError('test RPC revoke failed')
+
