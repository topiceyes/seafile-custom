From 9f928e5a4d2b4ef2107aaa5962b5802f4682c174 Mon Sep 17 00:00:00 2001
From: topiceyes <273286342+topiceyes@users.noreply.github.com>
Date: Sun, 20 Sep 2026 12:19:47 +0800
Subject: [PATCH 8/9] Restrict password login to administrators

Ordinary users' only entry is DingTalk SSO; password login (web form and
/api2/auth-token/) is now denied for non-staff users.

- AuthBackend.authenticate: deny after password check (covers API token
  requests that bypass the form)
- AuthenticationForm.clean: deny before password check with a clear
  message; db_record=False so the block is not counted as a failed
  attempt
- login template: render the new error key
- PASSWORD_LOGIN_ADMIN_ONLY setting, default True; set False in
  seahub_settings.py to re-enable in emergencies

DingTalk SSO (OauthRemoteUserBackend, remote_user signature), API tokens,
client SSO and WebDAV are unaffected.
---
 seahub/auth/forms.py                     | 11 +++++++++++
 seahub/base/accounts.py                  |  7 +++++++
 seahub/settings.py                       |  8 ++++++++
 seahub/templates/registration/login.html |  3 +++
 4 files changed, 29 insertions(+)

diff --git a/seahub/auth/forms.py b/seahub/auth/forms.py
index 2f00429..9735145 100644
--- a/seahub/auth/forms.py
+++ b/seahub/auth/forms.py
@@ -23,6 +23,9 @@ from captcha.fields import CaptchaField
 from seahub.utils.password import get_password_strength_requirements, \
         is_password_strength_valid
 
+# [dev] 0008: 普通用户密码登录被禁用时的提示（钉钉 SSO 是唯一入口）
+PASSWORD_LOGIN_BLOCKED_MSG = '账号密码登录仅对管理员开放，请使用钉钉扫码登录。'
+
 
 class AuthenticationForm(forms.Form):
     """
@@ -67,6 +70,14 @@ class AuthenticationForm(forms.Form):
                     if not is_first_login or not settings.ACTIVATE_AFTER_FIRST_LOGIN:
                         self.errors['inactive'] = _("This account is inactive.")
                         raise forms.ValidationError(_("This account is inactive."))
+                # [dev] 0008: 密码登录仅限管理员，普通用户唯一入口是钉钉 SSO。
+                # 在密码校验前拦截，给出明确提示；backend 层另有兜底，见
+                # seahub/base/accounts.py 的 AuthBackend.authenticate。
+                # db_record=False：策略拒绝不算登录失败记录（不触发验证码/冻结）。
+                if settings.PASSWORD_LOGIN_ADMIN_ONLY and not user.is_staff:
+                    self.db_record = False
+                    self.errors['password_login_admin_only'] = PASSWORD_LOGIN_BLOCKED_MSG
+                    raise forms.ValidationError(PASSWORD_LOGIN_BLOCKED_MSG)
             except User.DoesNotExist:
                 pass
 
diff --git a/seahub/base/accounts.py b/seahub/base/accounts.py
index 5c3f4f5..8e00e84 100644
--- a/seahub/base/accounts.py
+++ b/seahub/base/accounts.py
@@ -830,6 +830,13 @@ class AuthBackend(object):
             return None
 
         if user.check_password(password):
+            # [dev] 0008: 密码认证仅限管理员。表单层（seahub/auth/forms.py）
+            # 已给出中文提示；这里兜底拦住 /api2/auth-token/ 等绕过表单
+            # 直接调用 authenticate 的密码路径。放在 check_password 之后：
+            # 不改变密码错误时的行为与报错时序。
+            if settings.PASSWORD_LOGIN_ADMIN_ONLY and not user.is_staff:
+                logger.warning('Blocked password login of non-admin user: %s', username)
+                return None
             return user
 
 
diff --git a/seahub/settings.py b/seahub/settings.py
index 23fef9b..cdb38b4 100644
--- a/seahub/settings.py
+++ b/seahub/settings.py
@@ -316,6 +316,14 @@ ENABLE_MULTI_ADFS = False
 
 DISABLE_ADFS_USER_PWD_LOGIN = False
 
+# [dev] 0008: 除管理员（is_staff）外禁止密码登录——钉钉 SSO 是普通用户唯一入口。
+# 影响面：web 登录表单、/api2/auth-token/（见 seahub/auth/forms.py、
+# seahub/base/accounts.py 的拦截点）。
+# 不影响：钉钉 SSO（OauthRemoteUserBackend，remote_user 签名）、API token、
+# mobile-login/client-login、WebDAV（seafdav 走 ccnet RPC，不经 Django backend）。
+# 紧急放开：seahub_settings.py 里设 PASSWORD_LOGIN_ADMIN_ONLY = False 后重启。
+PASSWORD_LOGIN_ADMIN_ONLY = True
+
 ENABLE_OAUTH = False
 ENABLE_WATERMARK = False
 
diff --git a/seahub/templates/registration/login.html b/seahub/templates/registration/login.html
index 6b83948..5c73b7c 100644
--- a/seahub/templates/registration/login.html
+++ b/seahub/templates/registration/login.html
@@ -59,6 +59,9 @@ html, body, #wrapper { height:100%; }
         <p class="error mt-2">{{ form.errors.not_found }}</p>
         {% elif form.errors.disable_pwd_login %}
         <p class="error mt-2">{% trans "Please use Single Sign-On to login." %}</p>
+        {% elif form.errors.password_login_admin_only %}
+        {# [dev] 0008: 非管理员密码登录被策略拒绝，提示走钉钉扫码（消息文本在 seahub/auth/forms.py）#}
+        <p class="error mt-2">{{ form.errors.password_login_admin_only }}</p>
         {% else %}
         <p class="error mt-2">{% trans "Incorrect email or password" %}</p>
         {% endif %}
