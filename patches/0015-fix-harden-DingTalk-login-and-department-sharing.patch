+def dingtalk_login_redirect(request):
+    """Keep the login destination on the current origin and prevent HTTPS downgrade."""
+    target = request.session.get('dingtalk_login_redirect', '/')
+    if not url_has_allowed_host_and_scheme(target, allowed_hosts={request.get_host()},
+                                           require_https=request.is_secure()):
+        return '/'
+    return target
+
