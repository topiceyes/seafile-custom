diff --git a/tests/seahub/utils/test_fileserver_origin.py b/tests/seahub/utils/test_fileserver_origin.py
new file mode 100644
index 00000000..94968bd6
--- /dev/null
+++ b/tests/seahub/utils/test_fileserver_origin.py
@@ -0,0 +1,199 @@
+"""Request-local file transfer URLs must not use another entry's SERVICE_URL."""
+import json
+from concurrent.futures import ThreadPoolExecutor
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from django.core.exceptions import DisallowedHost
+from django.test import RequestFactory, SimpleTestCase, override_settings
+from rest_framework.test import APIRequestFactory, force_authenticate
+
+from seahub import utils
+from seahub.api2 import views
+
+
+@override_settings(
+    ALLOWED_HOSTS=['m-disc.example.test', 'i-disc.example.test', '192.0.2.10'],
+    USE_X_FORWARDED_HOST=False,
+    SECURE_PROXY_SSL_HEADER=('HTTP_X_FORWARDED_PROTO', 'https'),
+)
+class FileserverOriginFixtures(SimpleTestCase):
+    def setUp(self):
+        self.factory = RequestFactory()
+        self.canonical = patch('seahub.utils.get_service_url',
+                               return_value='https://canonical.example.test/site/')
+        self.canonical_mock = self.canonical.start()
+        self.addCleanup(self.canonical.stop)
+
+    def request(self, host='m-disc.example.test', secure=True, **headers):
+        return self.factory.get('/api2/example/?p=/nested', HTTP_HOST=host,
+                                secure=secure, **headers)
+
+
+class FileserverOriginTest(FileserverOriginFixtures):
+    def test_all_transfer_url_helpers_use_request_origin(self):
+        for origin, host, secure in [
+            ('https://m-disc.example.test', 'm-disc.example.test', True),
+            ('https://i-disc.example.test:7443', 'i-disc.example.test:7443', True),
+            ('http://192.0.2.10:9800', '192.0.2.10:9800', False),
+        ]:
+            request = self.request(host, secure)
+            root = origin + '/seafhttp'
+            urls = [
+                (utils.get_fileserver_root(request), root),
+                (utils.gen_file_upload_url('token', 'upload-api', request=request),
+                 root + '/upload-api/token'),
+                (utils.gen_file_upload_url('token', 'update-api', True, request=request),
+                 root + '/update-api/token?replace=1'),
+                (utils.gen_file_get_url('token', '报告 1.txt', request=request),
+                 root + '/files/token/%E6%8A%A5%E5%91%8A%201.txt'),
+                (utils.gen_block_get_url('token', 'block', request=request),
+                 root + '/blks/token/block'),
+                (utils.gen_block_get_url('token', None, request=request),
+                 root + '/blks/token/'),
+                (utils.gen_file_get_url_by_sharelink('share', request=request),
+                 root + '/f/share/'),
+                (utils.gen_file_get_url_new('repo', '/folder/file.txt', request=request),
+                 root + '/repos/repo/files/folder/file.txt/?op=download'),
+                (utils.gen_dir_zip_download_url('token', request=request), root + '/zip/token'),
+            ]
+            for actual, expected in urls:
+                with self.subTest(origin=origin, expected=expected):
+                    self.assertEqual(actual, expected)
+        self.canonical_mock.assert_not_called()
+
+    def test_trusted_proxy_scheme_and_ignored_forwarded_host(self):
+        request = self.request(secure=False, HTTP_X_FORWARDED_PROTO='https',
+                               HTTP_X_FORWARDED_HOST='i-disc.example.test:7443')
+        self.assertEqual(utils.get_fileserver_root(request),
+                         'https://m-disc.example.test/seafhttp')
+
+    def test_invalid_or_unallowed_host_is_rejected(self):
+        for host in ['evil.example.test', 'm-disc.example.test/evil']:
+            with self.subTest(host=host), self.assertRaises(DisallowedHost):
+                utils.get_fileserver_root(self.request(host))
+
+    def test_background_and_shared_links_keep_canonical_origin(self):
+        self.assertEqual(utils.get_fileserver_root(),
+                         'https://canonical.example.test/seafhttp')
+        self.assertEqual(utils.gen_file_upload_url('token', 'upload-api'),
+                         'https://canonical.example.test/seafhttp/upload-api/token')
+        self.assertEqual(utils.gen_shared_link('share', 'f'),
+                         'https://canonical.example.test/site/f/share/')
+        with patch.object(utils.seahub.settings, 'INNER_FILE_SERVER_ROOT',
+                          'http://127.0.0.1:8082'):
+            self.assertEqual(utils.gen_inner_file_get_url('token', 'file'),
+                             'http://127.0.0.1:8082/files/token/file')
+
+    def test_concurrent_origins_do_not_change_global_settings(self):
+        hosts = ['m-disc.example.test', 'i-disc.example.test:7443'] * 20
+        canonical_before = utils.seahub.settings.SERVICE_URL
+        def generate(host):
+            return utils.gen_file_upload_url('token', 'upload-api',
+                                             request=self.request(host))
+        with ThreadPoolExecutor(max_workers=4) as pool:
+            actual = list(pool.map(generate, hosts))
+        self.assertEqual(actual, ['https://%s/seafhttp/upload-api/token' % h for h in hosts])
+        self.assertEqual(utils.seahub.settings.SERVICE_URL, canonical_before)
+
+    def test_web_context_uses_request_origin_and_keeps_canonical_service_url(self):
+        from seahub.base import context_processors
+        defaults = SimpleNamespace(**{
+            key: value[0] for key, value in utils.seahub.settings.CONSTANCE_CONFIG.items()})
+        request = self.request()
+        request.user = SimpleNamespace(username='member@example.test', is_staff=False)
+        request.cloud_mode = False
+        # This is an API path, so base() does not fetch avatars. Settings here
+        # replace only unrelated site options, never the URL helper under test.
+        with patch.object(context_processors, 'config', defaults), \
+                patch.object(context_processors, 'get_service_url', return_value='https://canonical.example.test'), \
+                patch.object(context_processors, 'get_site_name', return_value='Test'), \
+                patch.object(context_processors, 'is_dingtalk_enabled', return_value=False), \
+                patch.object(context_processors, 'verify_chat_ai_config', return_value=False):
+            context = context_processors.base(request)
+        self.assertEqual(context['FILE_SERVER_ROOT'], 'https://m-disc.example.test/seafhttp/')
+        self.assertEqual(context['service_url'], 'https://canonical.example.test')
+
+
+class TransferEndpointOriginTest(FileserverOriginFixtures):
+    def setUp(self):
+        super().setUp()
+        self.api_factory = APIRequestFactory()
+        self.rpc = self.enterContext(patch.object(views, 'seafile_api'))
+        self.rpc.get_repo.return_value = SimpleNamespace(id='repo')
+        self.rpc.get_dir_id_by_path.return_value = 'directory'
+        self.rpc.get_fileserver_access_token.return_value = 'test-transfer-token'
+        self.permission = self.enterContext(patch.object(views, 'check_folder_permission', return_value='rw'))
+        self.enterContext(patch.object(views, 'check_quota', return_value=0))
+
+    def call(self, view, host, method='get', query='', authenticated=True):
+        request = getattr(self.api_factory, method)(
+            '/api2/repos/repo/upload-link/' + query, HTTP_HOST=host, secure=True)
+        if authenticated:
+            force_authenticate(request, user=SimpleNamespace(
+                username='member@example.test', is_authenticated=True))
+        return view.as_view(throttle_classes=[])(request, repo_id='repo')
+
+    def test_client_web_update_and_block_endpoints(self):
+        cases = [
+            (views.UploadLinkView, '', 'upload-api'),
+            (views.UploadLinkView, '?from=web', 'upload-aj'),
+            (views.UploadLinkView, '?replace=1', 'upload-api'),
+            (views.UpdateLinkView, '', 'update-api'),
+            (views.UpdateLinkView, '?from=web', 'update-aj'),
+            (views.UploadBlksLinkView, '', 'upload-blks-api'),
+            (views.UpdateBlksLinkView, '', 'update-blks-api'),
+        ]
+        for host in ['m-disc.example.test', 'i-disc.example.test:7443']:
+            for view, query, operation in cases:
+                with self.subTest(host=host, endpoint=view.__name__, query=query):
+                    response = self.call(view, host, query=query)
+                    self.assertEqual(response.status_code, 200)
+                    expected = 'https://%s/seafhttp/%s/test-transfer-token' % (host, operation)
+                    if query == '?replace=1':
+                        expected += '?replace=1'
+                    self.assertEqual(response.data, expected)
+
+    def test_raw_block_and_commit_urls_keep_the_same_origin(self):
+        response = self.call(views.UploadBlksLinkView, 'm-disc.example.test', method='post')
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(json.loads(response.content), {
+            'rawblksurl': 'https://m-disc.example.test/seafhttp/upload-raw-blks-api/test-transfer-token',
+            'commiturl': 'https://m-disc.example.test/seafhttp/upload-blks-api/test-transfer-token?commitonly=true&ret-json=true',
+            'blklist': [],
+        })
+
+    def test_download_response_and_block_endpoint_keep_request_origin(self):
+        request = self.request()
+        request.user = SimpleNamespace(username='member@example.test')
+        response = views.get_repo_file(request, 'repo', 'file-id', 'file.txt', 'download')
+        self.assertEqual(json.loads(response.content),
+                         'https://m-disc.example.test/seafhttp/files/test-transfer-token/file.txt')
+        force_authenticate(request, user=SimpleNamespace(
+            username='member@example.test', is_authenticated=True))
+        response = views.FileBlockDownloadLinkView.as_view(throttle_classes=[])(
+            request, repo_id='repo', file_id='file-id', block_id='block-id')
+        self.assertEqual(response.data,
+                         'https://m-disc.example.test/seafhttp/blks/test-transfer-token/block-id')
+
+    def test_permission_denied_does_not_mint_a_transfer_token(self):
+        self.permission.return_value = None
+        response = self.call(views.UploadLinkView, 'm-disc.example.test')
+        self.assertEqual(response.status_code, 403)
+        self.rpc.get_fileserver_access_token.assert_not_called()
+
+    def test_anonymous_request_does_not_mint_a_transfer_token(self):
+        response = self.call(views.UploadLinkView, 'm-disc.example.test', authenticated=False)
+        self.assertIn(response.status_code, [401, 403])
+        self.rpc.get_fileserver_access_token.assert_not_called()
+
+    def test_missing_library_does_not_mint_a_transfer_token(self):
+        self.rpc.get_repo.return_value = None
+        response = self.call(views.UploadLinkView, 'm-disc.example.test')
+        self.assertEqual(response.status_code, 404)
+        self.rpc.get_fileserver_access_token.assert_not_called()
+
+    def test_failed_token_creation_does_not_return_a_transfer_url(self):
+        self.rpc.get_fileserver_access_token.return_value = None
+        response = self.call(views.UploadLinkView, 'm-disc.example.test')
+        self.assertEqual(response.status_code, 500)
