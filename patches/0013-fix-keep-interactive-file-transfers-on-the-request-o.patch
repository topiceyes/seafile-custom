-
-    Returns:
-    	Constructed fileserver root.
+def get_fileserver_root(request=None):
+    """Return the file-transfer origin for this request.
+
+    Interactive transfers must stay on the entry used by the browser/client,
+    including its port. Django validates Host and handles the trusted proxy
+    scheme; do not read forwarded headers directly or change global settings.
+    Calls without a request (background jobs and office-server callbacks) keep
+    the canonical SERVICE_URL origin. Internal RPC/HTTP URLs are separate.
     """
+    if request is not None:
+        return request.build_absolute_uri('/seafhttp')
     return get_site_scheme_and_netloc() + '/seafhttp'
 
