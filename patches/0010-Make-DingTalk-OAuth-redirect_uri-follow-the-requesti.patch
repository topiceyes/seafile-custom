@@ -45,6 +45,26 @@ from seahub.dingtalk.settings import DINGTALK_QR_CONNECT_APP_ID, \
 logger = logging.getLogger(__name__)
 
 
+def get_request_scheme_and_netloc(request):
+    """[dev] Return scheme+netloc of the *requesting* host, for OAuth redirect_uri.
+
+    多入口部署（同一系统经多个域名访问，如内网域名 + 外网经云反代的域名）时，
+    OAuth 的 state 存在会话 cookie 里、按 host 隔离。redirect_uri 若固定取
+    SERVICE_URL（单值），从其它入口发起的用户会被回调到 SERVICE_URL 的域名，
+    那个域名下没有发起时的会话 → invalid state。
+
+    改为跟随发起请求的 host 后：回调与发起在同一域名，state 可读；登录后的
+    跳转本来就是相对路径，用户全程留在原入口。钉钉后台「登录与分享」的回调
+    域名支持配多个（逗号分隔），把每个入口的回调地址都登记上即可通过钉钉
+    侧的匹配校验。
+
+    host 已被 Django 的 ALLOWED_HOSTS 校验过，取它构造 redirect_uri 不会
+    引入开放重定向；scheme 由 SECURE_PROXY_SSL_HEADER 链路决定（经反代时
+    上游需传对 X-Forwarded-Proto）。
+    """
+    return request.scheme + '://' + request.get_host()
+
+
