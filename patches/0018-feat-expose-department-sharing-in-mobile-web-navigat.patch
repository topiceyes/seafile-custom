index 00000000..cbbb36fe
--- /dev/null
+++ b/frontend/src/pages/app/mobile-file-nav/index.js
@@ -0,0 +1,53 @@
+import React from 'react';
+import { Link } from '@gatsbyjs/reach-router';
+import PropTypes from 'prop-types';
+import { canAddRepo, gettext, siteRoot } from '@/utils/constants';
+import './index.css';
+
+function MobileFileNav({ currentTab, onTabClick, onShowSidePanel, isSidePanelClosed }) {
+  const items = [
+    ...(canAddRepo ? [{ tab: 'my-libs', label: gettext('My Libraries') }] : []),
+    { tab: 'department-spaces', label: gettext('Department sharing') },
+    { tab: 'shared-libs', label: gettext('Shared with me') },
+  ];
+
+  const navigate = (event, tab) => {
+    if (window.uploader && window.uploader.isUploadProgressDialogShow && window.uploader.totalProgress !== 100) {
+      if (!window.confirm(gettext('A file is being uploaded. Are you sure you want to leave this page?'))) {
+        event.preventDefault();
+        return;
+      }
+      window.uploader.isUploadProgressDialogShow = false;
+    }
+    onTabClick(tab);
+  };
+
+  return (
+    <nav className="mobile-file-nav" aria-label={gettext('Libraries')}>
+      {items.map(({ tab, label }) => {
+        const active = currentTab === tab || (tab === 'my-libs' && currentTab === 'deleted');
+        return (
+          <Link key={tab} to={`${siteRoot}${tab}/`}
+            className={`mobile-file-nav__link${active ? ' is-active' : ''}`}
+            aria-current={active ? 'page' : undefined}
+            onClick={event => navigate(event, tab)}>
+            {label}
+          </Link>
+        );
+      })}
+      <button type="button" className="mobile-file-nav__more" onClick={onShowSidePanel}
+        aria-expanded={!isSidePanelClosed} aria-controls="app-side-panel">
+        {gettext('More')}
+      </button>
+    </nav>
+  );
+}
+
+MobileFileNav.propTypes = {
+  currentTab: PropTypes.oneOfType([PropTypes.string, PropTypes.number]).isRequired,
+  onTabClick: PropTypes.func.isRequired,
+  onShowSidePanel: PropTypes.func.isRequired,
+  isSidePanelClosed: PropTypes.bool.isRequired,
+};
+
+export default MobileFileNav;
diff --git a/frontend/src/pages/app/mobile-file-nav/index.test.js b/frontend/src/pages/app/mobile-file-nav/index.test.js
new file mode 100644
index 00000000..c7606f35
--- /dev/null
+++ b/frontend/src/pages/app/mobile-file-nav/index.test.js
@@ -0,0 +1,57 @@
+import React, { act } from 'react';
+import { createRoot } from 'react-dom/client';
+import MobileFileNav from './index';
+
+let mockCanAddRepo = true;
+jest.mock('@/utils/constants', () => ({ get canAddRepo() { return mockCanAddRepo; }, siteRoot: '/drive/', gettext: text => text }));
+jest.mock('@gatsbyjs/reach-router', () => ({
+  Link: ({ to, children, ...props }) => <a href={to} {...props}>{children}</a>,
+}));
+
+let container;
+let root;
+let props;
+beforeEach(() => {
+  global.IS_REACT_ACT_ENVIRONMENT = true;
+  mockCanAddRepo = true;
+  container = document.createElement('div');
+  document.body.appendChild(container);
+  root = createRoot(container);
+  props = { currentTab: 'department-spaces', onTabClick: jest.fn(), onShowSidePanel: jest.fn(), isSidePanelClosed: true };
+});
+afterEach(() => {
+  act(() => root.unmount());
+  container.remove();
+  delete window.uploader;
+  jest.restoreAllMocks();
+});
+
+it('keeps department sharing separate, with the same routes and active state', () => {
+  act(() => root.render(<MobileFileNav {...props} />));
+  expect([...container.querySelectorAll('a')].map(link => link.getAttribute('href'))).toEqual([
+    '/drive/my-libs/', '/drive/department-spaces/', '/drive/shared-libs/'
+  ]);
+  expect(container.querySelector('[aria-current="page"]').textContent).toBe('Department sharing');
+});
+
+it('respects the personal-library capability and exposes the full navigation', () => {
+  mockCanAddRepo = false;
+  act(() => root.render(<MobileFileNav {...props} />));
+  expect(container.querySelector('a[href="/drive/my-libs/"]')).toBeNull();
+  const more = container.querySelector('button');
+  act(() => more.click());
+  expect(props.onShowSidePanel).toHaveBeenCalledTimes(1);
+  expect(more.getAttribute('aria-controls')).toBe('app-side-panel');
+  expect(more.getAttribute('aria-expanded')).toBe('false');
+});
+
+it('cancels navigation if an unfinished upload should stay on the page', () => {
+  window.uploader = { isUploadProgressDialogShow: true, totalProgress: 30 };
+  jest.spyOn(window, 'confirm').mockReturnValue(false);
+  act(() => root.render(<MobileFileNav {...props} />));
+  const event = new MouseEvent('click', { bubbles: true, cancelable: true });
+  act(() => container.querySelector('a').dispatchEvent(event));
+  expect(event.defaultPrevented).toBe(true);
+  expect(props.onTabClick).not.toHaveBeenCalled();
+  expect(window.uploader.isUploadProgressDialogShow).toBe(true);
+});
