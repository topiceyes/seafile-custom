# 离职员工同步（容器内 cron 自动加载 /etc/cron.d/ 下的文件）
# 生产：随镜像烘到 /etc/cron.d/dingtalk-sync（见 image/Dockerfile 第 7 项）
# dev ：官方镜像没烘 cron，由 seafile-server.yml 从同一路径挂载，两边内容不会漂移
# 日志：数据卷内的 /shared/seafile/logs/dingtalk-sync.log
#       （开发机 = deploy/seafile-data/seafile/logs/，生产 = $SEAFILE_VOLUME/seafile/logs/）
17 * * * * root cd /opt/seafile/seafile-server-latest/seahub && /usr/local/bin/seafile-management-task deactivate_departed_users >> /shared/seafile/logs/dingtalk-sync.log 2>&1 || echo "$(date -Is) dingtalk-sync FAILED" >> /shared/seafile/logs/dingtalk-sync.log
# sync_dingtalk_departments 保留旧命令名，已委托独立部门空间同步，不再创建群组。
# 成员和主管按钉钉对齐；现有个人库保留原所有权，旧部门群组仅兼容已有共享。
23 * * * * root cd /opt/seafile/seafile-server-latest/seahub && /usr/local/bin/seafile-management-task sync_dingtalk_departments >> /shared/seafile/logs/dingtalk-sync.log 2>&1 || echo "$(date -Is) department-spaces-sync FAILED" >> /shared/seafile/logs/dingtalk-sync.log
