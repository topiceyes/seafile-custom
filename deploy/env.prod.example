# Seafile 生产环境部署配置模板
#
# 用法：由 init-prod-env.sh 生成 .env（密钥自动生成、零提问）——
# 手抄容易漏改密钥或改错行，脚本帮你去掉这一类错。
#
# ⚠️ 本文件名【故意不带前导点】。它同时是 GitHub Release 的资产名，而 GitHub 会把
#    点开头的资产名改写成 default.xxx（2026-09-21 实测），固定安装 URL 就取不到了。
#    别再加回那个点。真正生成的 .env 仍然带点，仍然不入库（.gitignore 已排除）。
#
# 完整部署流程见 docs/007-production-deployment.md。
COMPOSE_FILE='seafile-prod.yml'

# 站点域名（纯域名，不带协议/端口）。填【用户在浏览器里输入的那个域名】——
# 它同时决定 nginx server_name、SERVICE_URL 和钉钉回调地址。反代模式下不是容器地址。
SEAFILE_DOMAIN='seafile.example.com'

# ---- TLS 终止位置：两种模式二选一（详见 docs/007 §9）----
#
#   A) 容器自己签 Let's Encrypt 证书（需 DNS 指向本机 + 80 端口公网可达）
#      SEAFILE_SERVER_LETSENCRYPT='true'
#      SEAFILE_SERVER_PROTOCOL='https'
#
#   B) 上游云反向代理终止 TLS，容器只监听 80  ← 本项目生产实际形态
#      证书装在代理上；代理用明文 http 转发到本机 80 端口。
#      ⚠️ SEAFILE_SERVER_PROTOCOL 必须显式设 https：它决定 SERVICE_URL /
#         FILE_SERVER_ROOT 的协议，不设会生成 http:// 链接，导致文件上传下载、
#         分享链接、钉钉回调地址全错（而页面本身还能打开，很难查）。
#      另注：代理侧要放开请求体大小限制（本容器 location / 已设 client_max_body_size 0）
SEAFILE_SERVER_LETSENCRYPT='false'
SEAFILE_SERVER_PROTOCOL='https'

# ---- 镜像版本【不在这里，也不用你管】----
#
# 镜像跟随的是**通道 tag**，写在入库的 deploy/seafile-prod.yml 里那一行：
#
#     image: ${SEAFILE_PRO_IMAGE:-ghcr.io/topiceyes/seafile-mc:latest}
#
# 那条 latest 是个指针：CI 每次「构建 + 冒烟全绿」之后把它搬过去。所以
#
#     升级 = docker compose pull && docker compose up -d
#
# 服务器上不需要改任何文件、也不需要重取仓库。发布记录（含每个版本的 tag 与
# digest）在 GitHub Releases，见 docs/010 §9。
# 仓库与镜像包都是 public，拉取不需要 docker login。
# 机器上只有 docker-compose（v1）的：上面的命令原样换成 docker-compose 即可，等效。
#
# ⚠️ 只有这两种场合才在这里写 SEAFILE_PRO_IMAGE，而且**更推荐写成命令行内联**
#    （`SEAFILE_PRO_IMAGE=… docker compose pull && … docker compose up -d`），
#    免得留在文件里被遗忘：
#      · 紧急回滚 —— 钉回某个不可变 tag
#        SEAFILE_PRO_IMAGE='ghcr.io/topiceyes/seafile-mc:12.0.14-dingtalk.9.<hash>'
#      · 离线导入 —— 见下
#    一旦写进本文件（且没注释掉），这台机器就**不再跟随发布**，固定在那个版本上。
#    这是刻意的 pin，不是"改了没生效"——但必须是有意识地为之。
#
# ⚠️ 离线导入（deploy/make-offline-bundle.sh）**不需要**动这一行：包里已经同时带了
#    通道 tag，compose 会直接命中本地镜像。
#    （必须用 tag 形式不能 digest 的理由仍然成立：docker save 一个按 digest 拉下来的
#    镜像会写出 "RepoTags": null，docker load 后是无标签的悬空镜像，compose 按
#    repo@sha256:… 找不到它，于是又去联网拉、又失败。）

# 数据持久化目录（服务器绝对路径，磁盘要够大：库 + 上传文件 + 备份都在这）
SEAFILE_VOLUME='/data/seafile'
SEAFILE_MYSQL_VOLUME='/data/seafile-mysql'

# MariaDB
# 生成：openssl rand -hex 16
SEAFILE_MYSQL_ROOT_PASSWORD='change-me'
SEAFILE_MYSQL_DB_HOST='db'
SEAFILE_MYSQL_DB_USER='seafile'
SEAFILE_MYSQL_DB_PASSWORD='change-me'

# Seafile 12 内部服务 JWT 认证密钥
# 生成：openssl rand -base64 48
JWT_PRIVATE_KEY=''

# 首次启动自动创建的管理员。⚠️ 只在【首次】启动生效，之后改这里没有任何作用。
# 改密码用容器内那个脚本（不在本仓库里，它在镜像内）：
#   docker exec -it seafile /opt/seafile/seafile-server-latest/reset-admin.sh
# 忘了密码时也可以直接改本文件里的 SEAFILE_ADMIN_PASSWORD 后删掉数据卷重来——
# 但那只在「本来就要重来」时才是划算的，日常改密码用上面那条命令。
SEAFILE_ADMIN_EMAIL='admin@example.com'
SEAFILE_ADMIN_PASSWORD='change-me'

# ---- 可选：钉钉企业内部应用凭据（钉钉开发者后台 → 应用 → 凭证与基础信息）----
# 一般【留空】。钉钉凭据已 constance 化，装完在「系统管理 → 设置」页填，免重启生效，
# 比写进这里更合适（这里写了会被镜像内的 custom_bootstrap.py 当作默认值追加进
# seahub_settings.py，之后后台改了以数据库为准）。留空则根本不写这两行。
#
# 注意 SEAHUB_ 前缀：容器里传的是 SEAHUB_DINGTALK_*，与 seahub_settings.py 里的
# DINGTALK_* 差一个前缀，别写错。
SEAHUB_DINGTALK_APP_KEY=''
SEAHUB_DINGTALK_APP_SECRET=''
