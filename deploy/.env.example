# Seafile 部署配置模板（dev）。生产用 .env.prod.example。
# 用法：cp .env.example .env 然后填入自己的值。.env 已被 .gitignore 排除。
COMPOSE_FILE='seafile-server.yml'

# 站点域名（渲染进 seahub_settings.py 的 SERVICE_URL/FILE_SERVER_ROOT；dev 用本机 IP）
SEAFILE_DOMAIN='127.0.0.1'

# 数据持久化目录（宿主机）。首次启动前需保证目录可写。
SEAFILE_VOLUME='./seafile-data'
SEAFILE_MYSQL_VOLUME='./seafile-mysql-db'

# MariaDB
SEAFILE_MYSQL_ROOT_PASSWORD='change-me'
SEAFILE_MYSQL_DB_HOST='db'
SEAFILE_MYSQL_DB_USER='seafile'
SEAFILE_MYSQL_DB_PASSWORD='change-me'

# Seafile 12 内部服务 JWT 认证密钥
# 生成：openssl rand -base64 48
JWT_PRIVATE_KEY=''

# 初始化时自动创建的管理员（仅首次启动生效）
SEAFILE_ADMIN_EMAIL='admin@example.com'
SEAFILE_ADMIN_PASSWORD='change-me'

# ---- 由 conf-templates/ 渲染进 seahub_settings.py（见 init-conf.sh）----
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SEAHUB_SECRET_KEY=''
# 注意：这是镜像首次启动时 MariaDB 里 seafile 用户的密码，
# 与 .env 上方的 SEAFILE_MYSQL_DB_PASSWORD 不一定是同一个值。
# 查法：docker exec seafile-mysql mysql -uroot -p"$SEAFILE_MYSQL_ROOT_PASSWORD" \
#         -e "SELECT user,host FROM mysql.user;"
SEAHUB_DB_PASSWORD=''

# 钉钉企业内部应用凭据（钉钉开发者后台 → 应用 → 凭证与基础信息）
SEAHUB_DINGTALK_APP_KEY=''
SEAHUB_DINGTALK_APP_SECRET=''
