# Seafile 生产环境部署配置模板
# 用法：cp .env.prod.example .env && 填值。.env 不入库（.gitignore 已排除）。
# 完整部署流程见 docs/007-production-deployment.md。
COMPOSE_FILE='seafile-prod.yml'

# 站点域名（纯域名，不带协议/端口）。DNS A 记录必须已指向本服务器公网 IP，
# 80 端口必须公网可达（Let's Encrypt webroot 验证）。也是钉钉回调域名的基础。
SEAFILE_DOMAIN='seafile.example.com'

# 自建镜像。由 GitHub Actions 构建并推送到 ghcr.io（见 docs/010），
# tag 与 seahub 补丁数联动，每次构建出的 digest 记在 docs/010 §9 台账里。
# 更新：改这里的 tag → docker compose pull && docker compose up -d
# 拉取前需先登录（私有镜像，PAT 需 read:packages）：
#   echo "$PAT" | docker login ghcr.io -u <github用户名> --password-stdin
SEAFILE_PRO_IMAGE='ghcr.io/topiceyes/seafile-mc:12.0.14-dingtalk.8'
# 要钉死版本（防 tag 漂移）就改用 digest 形式，把 tag 换成上表记录的 digest：
# SEAFILE_PRO_IMAGE='ghcr.io/topiceyes/seafile-mc@sha256:<digest>'

# 数据持久化目录（服务器绝对路径，磁盘要够大：库 + 上传文件 + 备份都在这）
SEAFILE_VOLUME='/data/seafile'
SEAFILE_MYSQL_VOLUME='/data/seafile-mysql'

# MariaDB
# 生成：openssl rand -hex 16
SEAFILE_MYSQL_ROOT_PASSWORD='change-me'
SEAFILE_MYSQL_DB_HOST='db'
SEAFILE_MYSQL_DB_USER='seafile'
SEAFILE_MYSQL_DB_PASSWORD='change-me'

# Seafile 12 内部服务 JWT 认证密钥
# 生成：openssl rand -base64 48
JWT_PRIVATE_KEY=''

# 首次启动自动创建的管理员（仅首次生效；之后用 reset-admin.sh 改）
SEAFILE_ADMIN_EMAIL='admin@example.com'
SEAFILE_ADMIN_PASSWORD='change-me'

# ---- 以下由 init-conf.sh --prod 在首启完成后追加进 seahub_settings.py ----
# （SECRET_KEY 与数据库配置由首启 setup 自动生成，无需预置）
# 钉钉企业内部应用凭据（钉钉开发者后台 → 应用 → 凭证与基础信息）
SEAHUB_DINGTALK_APP_KEY=''
SEAHUB_DINGTALK_APP_SECRET=''
